<?xml version="1.0" encoding="utf-8" ?>

<Defs>
	<Vehicles.VehicleBuildDef ParentName="RT_BaseVehicleBuild"><!-- 建築型態的載具，基本上與BuildingDef相同-->
		<defName>RT_BM13_Vehicle_Blueprint</defName>
		<label>BM-13</label>
		<description>A kind of rocket artillery designed for efficient firepower projection, without defence weapon and armor.</description>
		<graphicData>
			<texPath>Vehicles/BM13/vehicle</texPath>
			<drawSize>(5.6,5.6)</drawSize>
		</graphicData>
		<size>(2,4)</size>
		<statBases> 		
			<MaxHitPoints>500</MaxHitPoints>
			<WorkToBuild>50000</WorkToBuild>
			<Flammability>0.05</Flammability>
		</statBases>		
		<constructionSkillPrerequisite>6</constructionSkillPrerequisite>	
				<costList>
			<EngineMedium>1</EngineMedium>
			<ComponentFuelTank>2</ComponentFuelTank>
			<ComponentTransmission>1</ComponentTransmission>
			<ComponentWheelTire>6</ComponentWheelTire>
			<ComponentIndustrial>35</ComponentIndustrial>
			<ComponentAdvanced>3</ComponentAdvanced>
			<Mechanism>32</Mechanism>
			<AdvMechanism>6</AdvMechanism>
			<Steel>600</Steel>
			<AluminiumBar>200</AluminiumBar>
			<ReinforcedGlass>6</ReinforcedGlass>
			<Chemfuel>150</Chemfuel>
		</costList>	
		<thingToSpawn>RT_BM13_Vehicle</thingToSpawn>	<!-- 建造後生成的載具Kind,這是與建築唯一不一樣的-->
	    <researchPrerequisites Inherit="False">
      <li>RT_WW2HeavyArmor</li>
    </researchPrerequisites>
  </Vehicles.VehicleBuildDef>
	
	<Vehicles.VehicleDef ParentName="RT_BaseVehicle">
		<defName>RT_BM13_Vehicle</defName>
		<label>BM-13</label>
		<description>A kind of rocket artillery designed for efficient firepower projection, without defence weapon and armor.</description>
		<buildDef>RT_BM13_Vehicle_Blueprint</buildDef>		
		<graphicData>
			<texPath>Vehicles/BM13/vehicle</texPath>
			<drawSize>(5.6,5.6)</drawSize>
		</graphicData>		
		<size>(2, 4)</size>
		<fillPercent>1</fillPercent>	
		<vehicleCategory>Transport</vehicleCategory>
		<statBases>
			<ArmorRating_Blunt>0.22</ArmorRating_Blunt>
			<ArmorRating_Sharp>0.38</ArmorRating_Sharp>
			<Flammability>0</Flammability>
			<MarketValue>2050</MarketValue>
		</statBases>		
		<vehicleStats>
			<Mass>385</Mass>
			<MoveSpeed>8</MoveSpeed>
			<CargoCapacity>400</CargoCapacity>
			<RepairRate>0.5</RepairRate>
		</vehicleStats>
		<soundOneShotsOnEvent Inherit = "False">
			<li>
				<key>PawnEntered</key>
				<value>VVE_VehicleEnter</value>
			</li>
			<li>
				<key>PawnExited</key>
				<value>VVE_VehicleEnter</value>
			</li>
			<li>
				<key>IgnitionOn</key>
				<value>RT_WheeledVehicleStart</value>
			</li>
			<li>
				<key>IgnitionOff</key>
				<value>RT_WheeledVehicleStop</value>
			</li>
		</soundOneShotsOnEvent>
		<soundSustainersOnEvent Inherit = "False"> 
			<li>
				<start>IgnitionOn</start>
				<stop>IgnitionOff</stop>
				<value>RT_WheeledVehicleEngine</value>
			</li>
		</soundSustainersOnEvent>
		<race>
			<baseBodySize>3</baseBodySize>
		</race>	
		<properties>
			<customRoadCosts AssignDefaults = "0.25"/>
			<worldSpeedMultiplier>1</worldSpeedMultiplier>
			<offRoadMultiplier>2</offRoadMultiplier>
			<winterSpeedMultiplier>4</winterSpeedMultiplier>
			<vehicleJobLimitations>
				<li>(RepairVehicle, 3)</li>
			</vehicleJobLimitations>		
			<roles>
				<li>
					<key>driver</key>
					<label>Driver</label>
					<slots>1</slots>
					<slotsToOperate>1</slotsToOperate>					
					<handlingTypes>
						<li>Movement</li>
					</handlingTypes>
					<hitbox>
						<cells>
							<li>(0, 1)</li>
						</cells>
					</hitbox>	
				</li>
				<li>
					<key>gunner</key>
					<label>gunner</label>
					<slots>1</slots>
					<slotsToOperate>1</slotsToOperate>
					<handlingTypes>Turret</handlingTypes>
					<hitbox>
						<cells>
							<li>(1, 1)</li>
						</cells>
					</hitbox>
					<turretIds>
						<li>BM13</li>
					</turretIds>
				</li>
			</roles>
		</properties>	
		<components>
			<!-- Internal mobile Part 內部驅動部件-->
			<li><!-- Engine 100-->
				<key>Engine</key>
				<label>Engine</label>
				<health>100</health>
				<priorityStatEfficiency>true</priorityStatEfficiency>
				<categories><li>MoveSpeed</li></categories>	
				<depth>Internal</depth>		
				<reactors>
					<li Class = "Vehicles.Reactor_Explosive">
						<indicator>VF_Explosive</indicator>
						<chance>0.25</chance>
						<maxHealth>0.3</maxHealth>
						<radius>3</radius>
						<damageDef>Bomb</damageDef>
					</li>
				</reactors>	
				<hitbox>
					<cells>
						<li>(0, 2)</li>
						<li>(1, 2)</li>
					</cells>
				</hitbox>						
			</li>
			<li><!-- LeftFrontSuspension 40-->
				<key>LeftFrontSuspension</key>
				<label>left front Suspension</label>
				<health>40</health>
				<depth>Internal</depth>			
				<hitbox>
					<cells>
						<li>(0, 2)</li>
					</cells>
				</hitbox>
				<categories><li>MoveSpeed</li></categories>
			</li>
			<li><!-- RightFrontSuspension 40-->
				<key>RightFrontSuspension</key>
				<label>right front suspension</label>
				<health>40</health>
				<depth>Internal</depth>
				<hitbox>
					<cells>
						<li>(1, 2)</li>
					</cells>
				</hitbox>
				<categories><li>MoveSpeed</li></categories>
			</li>
			<li><!-- LeftRearSuspension 40-->
				<key>LeftRearSuspension</key>
				<label>left rear suspension</label>
				<health>40</health>
				<depth>Internal</depth>
				<hitbox>
					<cells>
						<li>(0, -1)</li>
					</cells>
				</hitbox>
				<categories><li>MoveSpeed</li></categories>
			</li>
			<li><!-- RightRearSuspension 40-->
				<key>RightRearSuspension</key>
				<label>right rear suspension</label>
				<health>40</health>
				<depth>Internal</depth>
				<hitbox>
					<cells>
						<li>(1, -1)</li>
					</cells>
				</hitbox>
				<categories><li>MoveSpeed</li></categories>
			</li>
			<li><!-- Gearbox 45-->
				<key>Gearbox</key>
				<label>gear box</label>
				<health>45</health>
				<depth>Internal</depth>
				<hitbox>
					<cells>
						<li>(0, 1)</li>
						<li>(1, 1)</li>
					</cells>
				</hitbox>
				<categories><li>MoveSpeed</li></categories>
			</li>
			<li><!-- FuelTank 40-->
				<key>FuelTank</key>
				<label>fuel tank</label>
				<health>40</health>
				<depth>Internal</depth>			
				<reactors>
					<li Class = "Vehicles.Reactor_FuelLeak"/>
				</reactors>			
				<hitbox>
					<cells>
						<li>(0, 0)</li>
						<li>(1, 0)</li>
					</cells>
				</hitbox>
			</li>
		<!-- External mobile Part 外部驅動部件-->
			<li><!-- LeftFrontWheel 30-->
				<key>LeftFrontWheel</key>
				<label>left front Wheel</label>
				<health>30</health>
				<depth>External</depth>
				<categories><li>MoveSpeed</li></categories>
				<tags><li>Wheel</li></tags>	
				<armor>
					<ArmorRating_Blunt>0</ArmorRating_Blunt>
					<ArmorRating_Sharp>0</ArmorRating_Sharp>
				</armor>			
				<hitbox>
					<fallthrough>false</fallthrough>
					<cells>
						<li>(0, 2)</li>
					</cells>
				</hitbox>			
			</li>
			<li><!-- RightFrontWheel 30-->
				<key>RightFrontWheel</key>
				<label>right front Wheel</label>
				<health>30</health>
				<depth>External</depth>
				<categories><li>MoveSpeed</li></categories>
				<tags><li>Wheel</li></tags>	
				<armor>
					<ArmorRating_Blunt>0</ArmorRating_Blunt>
					<ArmorRating_Sharp>0</ArmorRating_Sharp>
				</armor>
				<hitbox>
					<fallthrough>false</fallthrough>
					<cells>
						<li>(1, 2)</li>
					</cells>
				</hitbox>
			</li>
			<li><!-- LeftRearWheel	30-->
				<key>LeftRearWheel</key>
				<label>left rear wheel</label>
				<health>30</health>
				<depth>External</depth>
				<categories><li>MoveSpeed</li></categories>
				<tags><li>Wheel</li></tags>	
				<armor>
					<ArmorRating_Blunt>0</ArmorRating_Blunt>
					<ArmorRating_Sharp>0</ArmorRating_Sharp>
				</armor>
				<hitbox>
					<fallthrough>false</fallthrough>
					<cells>
						<li>(0, -1)</li>
					</cells>
				</hitbox>
			</li>
			<li><!-- RightRearWheel 30-->
				<key>RightRearWheel</key>
				<label>right rear Wheel</label>
				<health>30</health>
				<depth>External</depth>
				<categories><li>MoveSpeed</li></categories>
				<tags><li>Wheel</li></tags>
				<armor>
					<ArmorRating_Blunt>0</ArmorRating_Blunt>
					<ArmorRating_Sharp>0</ArmorRating_Sharp>
				</armor>
				<hitbox>
					<fallthrough>false</fallthrough>
					<cells>
						<li>(1, -1)</li>
					</cells>
				</hitbox>
			</li>
		<!-- External Shell Part 外殼部件-->
			<li><!-- EngineHood 40-->
				<key>EngineHood</key>
				<label>engine hood</label>
				<health>60</health>
				<hitbox><side>Body</side></hitbox>
				<depth>External</depth>
			</li>
			<li><!-- Roof 40-->
				<key>Roof</key>
				<label>roof</label>
				<health>60</health>
				<hitbox><side>Body</side></hitbox>
				<depth>External</depth>
			</li>
			<li><!-- BackupTire 30-->
				<key>CargoHold</key>
				<label>cargo hold</label>
				<health>60</health>
				<hitbox><side>Body</side></hitbox>
				<depth>External</depth>
			</li>
			<li><!-- LeftDoorPanel 40-->
				<key>LeftDoorPanel</key>
				<label>left door panel</label>
				<health>60</health>
				<depth>External</depth>			
				<hitbox><side>Left</side></hitbox>
			</li>
			<li><!-- RightDoorPanel 40-->
				<key>RightDoorPanel</key>
				<label>right door panel</label>
				<health>60</health>
				<depth>External</depth>
				<hitbox><side>Right</side></hitbox>
			</li>
			<li><!-- FrontBumper 30-->
				<key>FrontBumper</key>
				<label>front bumper</label>
				<health>45</health>
				<depth>External</depth>
				<hitbox><side>Front</side></hitbox>
			</li>
			<li><!-- RearBumper 25-->
				<key>RearBumper</key>
				<label>rear bumper</label>
				<health>38</health>
				<depth>External</depth>
				<hitbox><side>Back</side></hitbox>
			</li>
			
		<!-- Internal Shell Part 內裝部件-->
			<li><!-- Interior 30-->
				<key>Interior</key>
				<label>interior</label>
				<health>30</health>
				<depth>Internal</depth>
			</li>
			<li><!-- Dashboard 30-->
				<key>Dashboard</key>
				<label>dashboard</label>
				<health>30</health>
				<depth>Internal</depth>
			</li>
			<li><!-- SteeringWheel 20-->
				<key>SteeringWheel</key>
				<label>steering wheel</label>
				<health>20</health>
				<depth>Internal</depth>
			</li>
		</components>
		<comps>
			<li Class="Vehicles.CompProperties_FueledTravel">
				<fuelType>Chemfuel</fuelType>
				<leakDef>Filth_Fuel</leakDef>
				<fuelConsumptionRate>18</fuelConsumptionRate>
				<fuelConsumptionWorldMultiplier>0.5</fuelConsumptionWorldMultiplier>
				<fuelCapacity>120</fuelCapacity>
			</li>
			<li Class="Vehicles.CompProperties_VehicleTurrets">
				<!-- 砲塔 -->
				<turrets>
					<li>
						<turretDef>RT_BM13_Turret</turretDef>
						<renderProperties>
							<north>(0, -0.9)</north>
							<south>(0, 1.2)</south>
							<east>(-1.5, 0.6)</east>
							<west>(1.5, 0.6)</west>
						</renderProperties>
						<angleRestricted>(330,30)</angleRestricted>
						<gizmoLabel>BM13</gizmoLabel>
						<aimPieOffset>(0, 2)</aimPieOffset>
						<!-- 預熱指示器的x,z偏移 -->
						<key>BM13</key>
					</li>
				</turrets>
			</li>
		</comps>
	</Vehicles.VehicleDef>

	<Vehicles.VehicleTurretDef ParentName="RT_BaseTurret">
		<defName>RT_BM13_Turret</defName>
		<label>BM13</label>
		<turretType>Rotatable</turretType>
		<shotSound>RT_Shot_BM13Sound</shotSound>
		<reloadSound>Artillery_ShellLoaded</reloadSound>
		
		<projectile>Rocket_M13_132mm</projectile>
		<reloadTimer>28</reloadTimer>
		
		<reloadTimerMultiplierPerCrewCount>
			<points>
				<li>(2, 1)</li>
				<li>(3, 0.5)</li>
			</points>
		</reloadTimerMultiplierPerCrewCount>
		
		<warmUpTimer>2</warmUpTimer>
		<chargePerAmmoCount>20</chargePerAmmoCount>
		
		<magazineCapacity>16</magazineCapacity>
		<genericAmmo>true</genericAmmo>
		
		<autoSnapTargeting>false</autoSnapTargeting>
		<rotationSpeed>0.5</rotationSpeed>
		
		<projectileOffset>1</projectileOffset>
		
		<minRange>20.9</minRange>
		
		<fireModes>
			<li>
				<shotsPerBurst>16</shotsPerBurst>
				<ticksBetweenShots>20</ticksBetweenShots>
				<ticksBetweenBursts>480</ticksBetweenBursts>
				<spreadRadius>9.9</spreadRadius>
				<label>Burst</label>
				<texPath>UI/Gizmos/FireRate_Burst</texPath>
			</li>
			<li>
				<shotsPerBurst>8</shotsPerBurst>
				<ticksBetweenShots>20</ticksBetweenShots>
				<ticksBetweenBursts>160</ticksBetweenBursts>
				<spreadRadius>9.9</spreadRadius>
				<label>Half</label>
				<texPath>UI/Gizmos/FireRate_Single</texPath>
			</li>
		</fireModes>

		<graphicData>
			<texPath>Vehicles/BM13/BM13</texPath>
			<graphicClass>Vehicles.Graphic_Turret</graphicClass>
			<shaderType>CutoutComplexPattern</shaderType>
			<drawSize>(5.5, 5.5)</drawSize>
			<layer>2</layer>
		</graphicData>
		
		<ammunition>
			<thingDefs>
				<li>Chemfuel</li>
			</thingDefs>
		</ammunition>
		
		<projectileShifting>
			<li>-0.75</li>
			<li>0.5</li>
			<li>-0.25</li>
			<li>0.125</li>
			<li>-0.125</li>
			<li>0.25</li>
			<li>-0.5</li>
			<li>0.75</li>
		</projectileShifting>
	</Vehicles.VehicleTurretDef>

	<ThingDef Class="Missile_dml._ThingDef" ParentName="BaseBullet">
		<defName>Rocket_M13_132mm</defName>
		<label>swarmer rocket</label>
		<thingClass>Missile_dml.missile_dml</thingClass>
		<graphicData>
			<texPath>Things/Projectile/Rocket_Swarm</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>1.2</drawSize>
		</graphicData>
		<fleck>RT_BM13_RocketSmoke</fleck>
		<fleck1>RT_BM13_RocketExhaust</fleck1>
		<frequency>0</frequency>
		<scale>1.5</scale>
		<shaking>0.3</shaking>
		<projectile>
			<damageDef>Bomb</damageDef>
			<damageAmountBase>120</damageAmountBase>
			<flyOverhead>true</flyOverhead>
			<speed>36</speed>
			<arcHeightFactor>35</arcHeightFactor>
			<explosionRadius>4.9</explosionRadius>
			<soundHitThickRoof>Artillery_HitThickRoof</soundHitThickRoof>
			<soundExplode>Explosion_Rocket</soundExplode>
			<soundImpactAnticipate>MortarRound_PreImpact</soundImpactAnticipate>
			<soundAmbient>MortarRound_Ambient</soundAmbient>
		</projectile>
		<drawOffscreen>true</drawOffscreen>
	</ThingDef>
	
	<FleckDef ParentName = "FleckBase_Thrown">
		<defName>RT_BM13_RocketSmoke</defName>
		<graphicData>
			<texPath>Things/Mote/Smoke</texPath>
			<renderInstanced>true</renderInstanced>
		</graphicData>
		
		<altitudeLayer>MoteOverhead</altitudeLayer>
		<fadeInTime>1</fadeInTime>
		<solidTime>4.5</solidTime>
		<fadeOutTime>2.5</fadeOutTime>
		<growthRate>0.01</growthRate>
	</FleckDef>
	
	<FleckDef ParentName="FleckBaseSmoke">
		<defName>RT_BM13_RocketExhaust</defName>
		<graphicData>
			<texPath>Things/Mote/FireGlow</texPath>
			<shaderType>MoteGlow</shaderType>
		</graphicData>
		<altitudeLayer>MoteOverheadLow</altitudeLayer>
		<solidTime>0.03</solidTime>
		<fadeOutTime>0.15</fadeOutTime>
	</FleckDef>
</Defs>