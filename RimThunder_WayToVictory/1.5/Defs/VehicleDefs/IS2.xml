					<li>
						<turretDef>RT_IS2_Tank_Turret</turretDef>
						<renderProperties>
							<north>(0, 0.8)</north>
							<south>(0, -0.35)</south>
							<east>(0.6, 0.4)</east>
							<west>(-0.6, 0.4)</west>
						</renderProperties>

						<gizmoLabel>Main Turret</gizmoLabel>
						<aimPieOffset>(0, 4)</aimPieOffset>
						<!-- 預熱指示器的x,z偏移 -->
