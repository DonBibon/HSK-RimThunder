<?xml version="1.0" encoding="UTF-8"?>
<Defs>

	<Vehicles.VehicleBuildDef ParentName="RT_BaseVehicleBuild">
		<!-- 建築型態的載具，基本上與BuildingDef相同-->
		<defName>RT_IS2_Vehicle_Blueprint</defName>
		<label>IS-2 Obr.1945</label>
		<description>A heavy tank named after the steel, equipped with an 122mm howitzer and machine guns, with good protection and strong firepower, but at the cost of long reload time.</description>
		<graphicData>
			<texPath>Vehicles/IS2/vehicle</texPath>
			<drawSize>(7,7)</drawSize>
		</graphicData>
		<statBases>
			<MaxHitPoints>500</MaxHitPoints>
			<WorkToBuild>100000</WorkToBuild>
			<Flammability>0.05</Flammability>
		</statBases>
		<size>(3,6)</size>
		<constructionSkillPrerequisite>8</constructionSkillPrerequisite>
				<costList>
			<EngineHeavy>1</EngineHeavy>
			<ComponentFuelTank>3</ComponentFuelTank>
			<ComponentTransmission>2</ComponentTransmission>
			<ComponentWheelRoad>16</ComponentWheelRoad>
			<ComponentHeavyCasting>6</ComponentHeavyCasting>
			<ComponentIndustrial>55</ComponentIndustrial>
			<ComponentAdvanced>7</ComponentAdvanced>
			<Mechanism>50</Mechanism>
			<AdvMechanism>10</AdvMechanism>
			<Steel>1200</Steel>
			<AluminiumBar>350</AluminiumBar>
			<Plasteel>120</Plasteel>
			<ReinforcedGlass>8</ReinforcedGlass>
			<Chemfuel>220</Chemfuel>
		</costList>
		<thingToSpawn>RT_IS2_Vehicle</thingToSpawn>
		<!-- 建造後生成的載具Kind,這是與建築唯一不一樣的-->
	    <researchPrerequisites Inherit="False">
      <li>RT_WW2HeavyArmor</li>
    </researchPrerequisites>
  </Vehicles.VehicleBuildDef>

	<!-- 載具本體 -->
	<Vehicles.VehicleDef ParentName="RT_BaseVehicle">
		<defName>RT_IS2_Vehicle</defName>
		<label>IS-2 Obr.1945</label>
		<description>A heavy tank named after the steel, equipped with an 122mm howitzer and machine guns, with good protection and strong firepower, but at the cost of long reload time.</description>
		<buildDef>RT_IS2_Vehicle_Blueprint</buildDef>
		<graphicData>
			<texPath>Vehicles/IS2/vehicle</texPath>
			<drawSize>(7,7)</drawSize>
		</graphicData>
		<size>(3,6)</size>
		<fillPercent>1</fillPercent>
		<vehicleCategory>Combat</vehicleCategory>
		<statBases>
			<ArmorRating_Blunt>0.8</ArmorRating_Blunt>
			<ArmorRating_Sharp>0.6</ArmorRating_Sharp>
			<Flammability>0</Flammability>
			<MarketValue>4150</MarketValue>
		</statBases>
		<vehicleStats>
			<Mass>2300</Mass>
			<MoveSpeed>7</MoveSpeed>
			<CargoCapacity>500</CargoCapacity>
			<RepairRate>0.6</RepairRate>
		</vehicleStats>
		<soundOneShotsOnEvent Inherit = "False">
			<li>
				<key>PawnEntered</key>
				<value>VVE_VehicleEnter</value>
			</li>
			<li>
				<key>PawnExited</key>
				<value>VVE_VehicleEnter</value>
			</li>
			<li>
				<key>IgnitionOn</key>
				<value>RT_T34VehicleStart</value>
			</li>
			<li>
				<key>IgnitionOff</key>
				<value>RT_T34VehicleStop</value>
			</li>
		</soundOneShotsOnEvent>
		<soundSustainersOnEvent Inherit="false"> 
			<li>
				<start>IgnitionOn</start>
				<stop>IgnitionOff</stop>
				<value>RT_T34VehicleEngine</value>
			</li>
		</soundSustainersOnEvent>
		<race>
			<baseBodySize>4</baseBodySize>
		</race>
		<properties>
			<!-- 座位與功能 -->
			<customRoadCosts AssignDefaults = "0.6"/>
			<worldSpeedMultiplier>1</worldSpeedMultiplier>
			<offRoadMultiplier>1.5</offRoadMultiplier>
			<winterSpeedMultiplier>2</winterSpeedMultiplier>
			<customHillinessCosts>
				<SmallHills>0.4</SmallHills>
				<LargeHills>1.2</LargeHills>
				<Mountainous>2.5</Mountainous>
			</customHillinessCosts>
			<vehicleJobLimitations>
				<li>(RepairVehicle, 5)</li>
			</vehicleJobLimitations>
			<roles>
				<li>
					<key>driver</key>
					<label>driver</label>
					<slots>1</slots>
					<slotsToOperate>1</slotsToOperate>
					<hitbox>
						<cells>
							<li>(0, 3)</li>
						</cells>
					</hitbox>
					<handlingTypes>
						<li>Movement</li>
						<li>Turret</li>
					</handlingTypes>
					<turretIds>
						<li>hullMG</li>
					</turretIds>
				</li>
				<li>
					<key>gunner</key>
					<label>gunner</label>
					<slots>3</slots>
					<slotsToOperate>2</slotsToOperate>
					<handlingTypes>Turret</handlingTypes>
					<hitbox>
						<cells>
							<li>(0, 0)</li>
							<li>(0, 1)</li>
							<li>(1, 0)</li>
						</cells>
					</hitbox>
					<turretIds>
						<li>mainTurret</li>
						<li>coaxialMG</li>
						<li>topMG</li>
					</turretIds>
				</li>
			</roles>
		</properties>
		<components>
			<!-- 各種零件 -->
			<!-- Internal mobile Part 內部驅動部件-->
			<li>
				<!--Engine 100-->
				<key>Engine</key>
				<label>Engine</label>
				<health>120</health>
				<priorityStatEfficiency>true</priorityStatEfficiency>
				<categories>
					<li>MoveSpeed</li>
				</categories>
				<depth>Internal</depth>
				<reactors>
