<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<ThingCategoryDef>
		<defName>Ammo132mmM13Rocket</defName>
		<label>132mm M-13 Rocket</label>
		<parent>AmmoRockets</parent>
		<iconPath>UI/Icons/ThingCategories/CaliberRocket</iconPath>
	</ThingCategoryDef>

	<!-- ==================== AmmoSet ========================== -->

	<CombatExtended.AmmoSetDef>
		<defName>AmmoSet_RT_132mmM13_directfire</defName>
		<label>132mm M13 Rockets</label>
		<ammoTypes>
			<Ammo_132mmM13_HE>Bullet_RT_132mmM13_HE_directfire</Ammo_132mmM13_HE>
		</ammoTypes>
		<isMortarAmmoSet>true</isMortarAmmoSet>
	</CombatExtended.AmmoSetDef>

	<!-- ==================== Ammo ========================== -->

	<ThingDef Class="CombatExtended.AmmoDef" Name="RT_132mmM13Base" ParentName="HeavyAmmoBase" Abstract="True">
		<description>132mm unguided high-explosive rocket used by the BM-13 "Katyusha" multiple rocket launcher.</description>
		<statBases>
			<MaxHitPoints>150</MaxHitPoints>
		</statBases>
		<tradeTags>
			<li>CE_AutoEnableTrade</li>
			<li>CE_AutoEnableCrafting_TableHeavyAmmunition</li>
		</tradeTags>
		<thingCategories>
			<li>Ammo132mmM13Rocket</li>
		</thingCategories>
		<stackLimit>25</stackLimit>
		<cookOffFlashScale>25</cookOffFlashScale>
		<cookOffSound>MortarBomb_Explode</cookOffSound>
	</ThingDef>

	<ThingDef Class="CombatExtended.AmmoDef" ParentName="RT_132mmM13Base">
		<defName>Ammo_132mmM13_HE</defName>
		<label>132mm M-13 rocket (HE)</label>
		<graphicData>
			<texPath>Things/Projectile/Rocket/132mmM13</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<statBases>
			<Mass>42.5</Mass>
			<Bulk>35.0</Bulk>
			<MarketValue>120</MarketValue>
		</statBases>
		<ammoClass>RocketHE</ammoClass>
		<detonateProjectile>Bullet_RT_132mmM13_HE_directfire</detonateProjectile>
	</ThingDef>

	<!-- ================== Projectiles ================== -->

	<ThingDef ParentName="BaseExplosiveBullet">
		<defName>Bullet_RT_132mmM13_HE_directfire</defName>
		<thingClass>CombatExtended.ProjectileCE_Explosive</thingClass>
		<label>132mm M-13 Rocket (HE)</label>
		<graphicData>
			<texPath>Things/Projectile/Rocket/132mmM13</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>TransparentPostLight</shaderType>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<speed>85</speed>
			<damageDef>Bomb</damageDef>
			<damageAmountBase>340</damageAmountBase>
			<explosionRadius>4.5</explosionRadius>
			<applyDamageToExplosionCellsNeighbors>true</applyDamageToExplosionCellsNeighbors>
			<flyOverhead>false</flyOverhead>
			<gravityFactor>1.5</gravityFactor>
			<soundAmbient>RocketPropelledLoop_Small</soundAmbient>
		</projectile>
		<comps>
			<li Class="CombatExtended.CompProperties_Fragments">
				<fragments>
					<Fragment_Large>40</Fragment_Large>
					<Fragment_Small>80</Fragment_Small>
				</fragments>
			</li>
		</comps>
	</ThingDef>

	<!-- ==================== Recipes ========================== -->

	<RecipeDef ParentName="LauncherAmmoRecipeBase">
		<defName>MakeAmmo_132mmM13_HE</defName>
		<label>make 132mm M-13 (HE) rockets x4</label>
		<description>Craft 4 132mm M-13 (HE) unguided rockets.</description>
		<jobString>Making 132mm M-13 rockets.</jobString>
		<workAmount>12000</workAmount>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Steel</li>
					</thingDefs>
				</filter>
				<count>120</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Powder</li>
					</thingDefs>
				</filter>
				<count>30</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Chemfuel</li>
					</thingDefs>
				</filter>
				<count>25</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>FSX</li>
					</thingDefs>
				</filter>
				<count>30</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>ComponentIndustrial</li>
					</thingDefs>
				</filter>
				<count>4</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>Steel</li>
				<li>Powder</li>
				<li>Chemfuel</li>
				<li>FSX</li>
				<li>ComponentIndustrial</li>
			</thingDefs>
		</fixedIngredientFilter>
		<products>
			<Ammo_132mmM13_HE>4</Ammo_132mmM13_HE>
		</products>
		<skillRequirements>
			<Crafting>5</Crafting>
		</skillRequirements>
	    <researchPrerequisite>RT_WW2HeavyArmor</researchPrerequisite>
  </RecipeDef>

</Defs>