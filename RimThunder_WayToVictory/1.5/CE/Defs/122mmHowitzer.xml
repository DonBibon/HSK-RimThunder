<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<ThingCategoryDef>
		<defName>Ammo122mmHowitzer</defName>
		<label>122mm Howitzer shell</label>
		<parent>AmmoShells</parent>
		<iconPath>UI/Icons/ThingCategories/CaliberCannon</iconPath>
	</ThingCategoryDef>

	<!-- ==================== AmmoSet ========================== -->

	<CombatExtended.AmmoSetDef>
		<defName>AmmoSet_122mmHowitzer</defName>
		<label>122mm Howitzer shells</label>
		<ammoTypes>
			<Ammo_122mmHowitzer_AP>Bullet_122mmHowitzer_AP</Ammo_122mmHowitzer_AP>
			<Ammo_122mmHowitzer_HE>Bullet_122mmHowitzer_HE</Ammo_122mmHowitzer_HE>
		</ammoTypes>
	</CombatExtended.AmmoSetDef>

	<!-- ==================== Ammo ========================== -->

	<ThingDef Class="CombatExtended.AmmoDef" Name="122mmHowitzerBase" ParentName="AmmoBase" Abstract="True">
		<description>High-caliber tank shell, typically used by heavily armored vehicles.</description>
		<thingCategories>
			<li>Ammo122mmHowitzer</li>
		</thingCategories>
		<stackLimit>25</stackLimit>
		<tradeTags>
			<li>CE_AutoEnableTrade</li>
			<li>CE_AutoEnableCrafting_TableHeavyAmmunition</li>
		</tradeTags>
		<statBases>
			<MaxHitPoints>250</MaxHitPoints>
			<Mass>22.3</Mass>
			<Bulk>66.09</Bulk>
		</statBases>
		<cookOffFlashScale>35</cookOffFlashScale>
		<cookOffSound>MortarBomb_Explode</cookOffSound>
	</ThingDef>

	<ThingDef Class="CombatExtended.AmmoDef" ParentName="122mmHowitzerBase">
		<defName>Ammo_122mmHowitzer_AP</defName>
		<label>122mmHowitzer Cannon shell (APHE)</label>
		<graphicData>
			<texPath>Things/Ammo/Cannon/Tank/APHE</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>
		<statBases>
			<MarketValue>149.17</MarketValue>
		</statBases>
		<ammoClass>ArmorPiercing</ammoClass>
		<detonateProjectile>Bullet_122mmHowitzer_AP</detonateProjectile>
	</ThingDef>

	<ThingDef Class="CombatExtended.AmmoDef" ParentName="122mmHowitzerBase">
		<defName>Ammo_122mmHowitzer_HE</defName>
		<label>122mmHowitzer Cannon shell (HE)</label>
		<graphicData>
			<texPath>Things/Ammo/Cannon/Tank/HE</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>
		<statBases>
			<MarketValue>172.67</MarketValue>
		</statBases>
		<ammoClass>GrenadeHE</ammoClass>
		<detonateProjectile>Bullet_122mmHowitzer_HE</detonateProjectile>
	</ThingDef>

	<!-- ================== Projectiles ================== -->

	<ThingDef Name="Base122mmHowitzer" ParentName="BaseExplosiveBullet" Abstract="true">
		<graphicData>
			<shaderType>TransparentPostLight</shaderType>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<speed>154</speed>
			<flyOverhead>false</flyOverhead>
			<dropsCasings>true</dropsCasings>
			<casingMoteDefname>Fleck_BigShell</casingMoteDefname>
			<casingFilthDefname>Filth_CannonAmmoCasings</casingFilthDefname>
		</projectile>
	</ThingDef>

	<ThingDef ParentName="Base122mmHowitzer">
		<defName>Bullet_122mmHowitzer_AP</defName>
		<label>122mmHowitzer Cannon shell (APHE)</label>
		<graphicData>
			<texPath>Things/Projectile/Bullet_Big</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<damageDef>Bullet</damageDef>
			<damageAmountBase>400</damageAmountBase>
			<soundExplode>MortarBomb_Explode</soundExplode>
			<armorPenetrationSharp>203</armorPenetrationSharp>
			<armorPenetrationBlunt>84000</armorPenetrationBlunt>
			<secondaryDamage>
				<li>
					<def>Bomb_Secondary</def>
					<amount>188</amount>
				</li>
			</secondaryDamage>
		</projectile>
	</ThingDef>

	<ThingDef ParentName="Base122mmHowitzer">
		<defName>Bullet_122mmHowitzer_HE</defName>
		<label>122mmHowitzer Cannon shell (HE)</label>
		<thingClass>CombatExtended.ProjectileCE_Explosive</thingClass>
		<graphicData>
			<texPath>Things/Projectile/Bullet_Big</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<damageDef>Bomb</damageDef>
			<damageAmountBase>300</damageAmountBase>
			<explosionRadius>4</explosionRadius>
			<soundExplode>MortarBomb_Explode</soundExplode>
			<applyDamageToExplosionCellsNeighbors>true</applyDamageToExplosionCellsNeighbors>
		</projectile>
		<comps>
			<li Class="CombatExtended.CompProperties_Fragments">
				<fragments>
					<Fragment_Large>30</Fragment_Large>
					<Fragment_Small>60</Fragment_Small>
				</fragments>
			</li>
		</comps>
	</ThingDef>

	<!-- ==================== Recipes ========================== -->

	<RecipeDef ParentName="AmmoRecipeBase">
		<defName>MakeAmmo_122mmHowitzer_AP</defName>
		<label>make 122mmHowitzer APHE cannon shells x5</label>
		<description>Craft 5 122mmHowitzer APHE cannon shells.</description>
		<jobString>Making 122mmHowitzer APHE cannon shells.</jobString>
		<workAmount>14000</workAmount>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Steel</li>
					</thingDefs>
				</filter>
				<count>160</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Powder</li>
					</thingDefs>
				</filter>
				<count>45</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>FSX</li>
					</thingDefs>
				</filter>
				<count>12</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>ComponentIndustrial</li>
					</thingDefs>
				</filter>
				<count>2</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>Steel</li>
				<li>Powder</li>
				<li>FSX</li>
				<li>ComponentIndustrial</li>
			</thingDefs>
		</fixedIngredientFilter>
		<products>
			<Ammo_122mmHowitzer_AP>5</Ammo_122mmHowitzer_AP>
		</products>
		<skillRequirements>
			<Crafting>5</Crafting>
		</skillRequirements>
	    <researchPrerequisite>RT_WW2HeavyArmor</researchPrerequisite>
  </RecipeDef>

