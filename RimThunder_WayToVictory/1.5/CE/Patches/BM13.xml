<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="RT_BM13_Turret"]/projectile</xpath>
		<value>
			<projectile>Bullet_RT_132mmM13_HE_directfire</projectile>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="RT_BM13_Turret"]/chargePerAmmoCount</xpath>
		<value>
			<chargePerAmmoCount>1</chargePerAmmoCount>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="RT_BM13_Turret"]/genericAmmo</xpath>
		<value>
			<genericAmmo>false</genericAmmo>
		</value>
	</Operation>

	<Operation Class="PatchOperationRemove">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="RT_BM13_Turret"]/projectileShifting</xpath>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="RT_BM13_Turret"]</xpath>
		<value>
			<maxRange>500</maxRange>
		</value>
	</Operation>

	<Operation Class="PatchOperationAddModExtension">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="RT_BM13_Turret"]</xpath>
		<value>
			<li Class="Vehicles.CETurretDataDefModExtension">
				<ammoSet>AmmoSet_RT_132mmM13_directfire</ammoSet>
				<shotHeight>3.5</shotHeight>
				<sway>2</sway>
				<spread>0.6</spread>
			</li>
		</value>
	</Operation>
	
	<!-- Vehicle -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_BM13_Vehicle"]/statBases/ArmorRating_Blunt</xpath>
		<value>
			<ArmorRating_Blunt>10</ArmorRating_Blunt>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_BM13_Vehicle"]/statBases/ArmorRating_Sharp</xpath>
		<value>
			<ArmorRating_Sharp>5</ArmorRating_Sharp>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_T3485_Vehicle"]/vehicleStats/CargoCapacity</xpath>
		<value>
			<CargoCapacity>800</CargoCapacity>
		</value>
	</Operation>

	<!--Front Armor-->


	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_BM13_Vehicle"]/components/li[key="EngineHood"]/health</xpath>
		<value>
			<health>100</health>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_BM13_Vehicle"]/components/li[key="EngineHood"]</xpath>
		<value>
			<armor>
				<ArmorRating_Blunt>10</ArmorRating_Blunt>
				<ArmorRating_Sharp>5</ArmorRating_Sharp>
			</armor>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_BM13_Vehicle"]/components/li[key="FrontBumper"]/health</xpath>
		<value>
			<health>100</health>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_BM13_Vehicle"]/components/li[key="FrontBumper"]</xpath>
		<value>
			<armor>
				<ArmorRating_Blunt>10</ArmorRating_Blunt>
				<ArmorRating_Sharp>5</ArmorRating_Sharp>
			</armor>
		</value>
	</Operation>

	<!--Side Armor-->

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_BM13_Vehicle"]/components/li[key="LeftDoorPanel" or key="RightDoorPanel"]/health</xpath>
		<value>
			<health>150</health>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_BM13_Vehicle"]/components/li[key="LeftDoorPanel" or key="RightDoorPanel"]</xpath>
		<value>
			<armor>
				<ArmorRating_Blunt>10</ArmorRating_Blunt>
				<ArmorRating_Sharp>5</ArmorRating_Sharp>
			</armor>
		</value>
	</Operation>

	<!--Rear Armor-->

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_BM13_Vehicle"]/components/li[key="RearBumper"]/health</xpath>
		<value>
			<health>100</health>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_BM13_Vehicle"]/components/li[key="RearBumper"]</xpath>
		<value>
			<armor>
				<ArmorRating_Blunt>10</ArmorRating_Blunt>
				<ArmorRating_Sharp>5</ArmorRating_Sharp>
			</armor>
		</value>
	</Operation>

	<!--Various exposed metallic stuff-->

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_BM13_Vehicle"]/components/li[key="LeftFrontWheel" or key="RightFrontWheel" or key="LeftRearWheel" or key="RightRearWheel"]/armor</xpath>
		<value>
			<armor>
				<ArmorRating_Blunt>10</ArmorRating_Blunt>
				<ArmorRating_Sharp>5</ArmorRating_Sharp>
			</armor>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_BM13_Vehicle"]/components/li[key="LeftFrontWheel" or key="RightFrontWheel" or key="LeftRearWheel" or key="RightRearWheel"]/health</xpath>
		<value>
			<health>60</health>
		</value>
	</Operation>

</Patch>
