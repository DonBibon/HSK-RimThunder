<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- Turret -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="RT_BA64_Turret"]</xpath>
		<value>
			<projectile>Bullet_762x54mmR_FMJ</projectile>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="RT_BA64_Turret"]/reloadTimer</xpath>
		<value>
			<reloadTimer>8</reloadTimer>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="RT_BA64_Turret"]/shotSound</xpath>
		<value>
			<shotSound>MediumMG</shotSound>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="RT_BA64_Turret"]/warmUpTimer</xpath>
		<value>
			<warmUpTimer>1.3</warmUpTimer>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="RT_BA64_Turret"]/genericAmmo</xpath>
		<value>
			<genericAmmo>false</genericAmmo>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="RT_BA64_Turret"]/chargePerAmmoCount</xpath>
		<value>
			<chargePerAmmoCount>1</chargePerAmmoCount>
		</value>
	</Operation>

	<Operation Class="PatchOperationRemove">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="RT_BA64_Turret"]/projectileShifting</xpath>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="RT_BA64_Turret"]</xpath>
		<value>
			<maxRange>62</maxRange>
		</value>
	</Operation>


	<Operation Class="PatchOperationAddModExtension">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="RT_BA64_Turret"]</xpath>
		<value>
			<li Class="Vehicles.CETurretDataDefModExtension">
				<ammoSet>AmmoSet_762x54mmR</ammoSet>
				<shotHeight>1.5</shotHeight>
				<speed>155</speed>
				<sway>0.94</sway>
				<spread>0.05</spread>
				<recoil>0.8</recoil>
			</li>
		</value>
	</Operation>

	<!-- Vehicle -->

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_BA64_Vehicle"]/statBases/ArmorRating_Blunt</xpath>
		<value>
			<ArmorRating_Blunt>10</ArmorRating_Blunt>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_BA64_Vehicle"]/statBases/ArmorRating_Sharp</xpath>
		<value>
			<ArmorRating_Sharp>4</ArmorRating_Sharp>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_BA64_Vehicle"]/vehicleStats/CargoCapacity</xpath>
		<value>
			<CargoCapacity>400</CargoCapacity>
		</value>
	</Operation>

	<!--Front Armor-->

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_BA64_Vehicle"]/components/li[key="FrontArmorPlating"]/health</xpath>
		<value>
			<health>350</health>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_BA64_Vehicle"]/components/li[key="FrontArmorPlating"]/armor</xpath>
		<value>
			<armor>
				<ArmorRating_Blunt>80</ArmorRating_Blunt>
				<ArmorRating_Sharp>15</ArmorRating_Sharp>
			</armor>
		</value>
	</Operation>

	<!--Side Armor-->

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_BA64_Vehicle"]/components/li[key="LeftArmorPlating" or key="RightArmorPlating"]/health</xpath>
		<value>
			<health>250</health>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_BA64_Vehicle"]/components/li[key="LeftArmorPlating" or key="RightArmorPlating"]/armor</xpath>
		<value>
			<armor>
				<ArmorRating_Blunt>80</ArmorRating_Blunt>
				<ArmorRating_Sharp>9</ArmorRating_Sharp>
			</armor>
		</value>
	</Operation>

	<!--Roof Armor-->

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_BA64_Vehicle"]/components/li[key="RoofArmorPlating"]/health</xpath>
		<value>
			<health>250</health>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_BA64_Vehicle"]/components/li[key="RoofArmorPlating"]/armor</xpath>
		<value>
			<armor>
				<ArmorRating_Blunt>80</ArmorRating_Blunt>
				<ArmorRating_Sharp>9</ArmorRating_Sharp>
			</armor>
		</value>
	</Operation>

	<!--Rear Armor-->

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_BA64_Vehicle"]/components/li[key="BackArmorPlating"]/health</xpath>
		<value>
			<health>400</health>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_BA64_Vehicle"]/components/li[key="BackArmorPlating"]/armor</xpath>
		<value>
			<armor>
				<ArmorRating_Blunt>80</ArmorRating_Blunt>
				<ArmorRating_Sharp>9</ArmorRating_Sharp>
			</armor>
		</value>
	</Operation>

	<!--Turret Armor-->

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_BA64_Vehicle"]/components/li[key="MainTurret"]/health</xpath>
		<value>
			<health>400</health>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_BA64_Vehicle"]/components/li[key="MainTurret"]/armor</xpath>
		<value>
			<armor>
				<ArmorRating_Blunt>80</ArmorRating_Blunt>
				<ArmorRating_Sharp>12</ArmorRating_Sharp>
			</armor>
		</value>
	</Operation>

	<!--Various exposed metallic stuff-->

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_BA64_Vehicle"]/components/li[key="LeftFrontWheel" or key="RightFrontWheel" or key="LeftRearWheel" or key="RightRearWheel"]/health</xpath>
		<value>
			<health>70</health>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_BA64_Vehicle"]/components/li[key="LeftFrontWheel" or key="RightFrontWheel" or key="LeftRearWheel" or key="RightRearWheel"]/armor</xpath>
		<value>
			<armor>
				<ArmorRating_Sharp>5</ArmorRating_Sharp>
				<ArmorRating_Blunt>10</ArmorRating_Blunt>
			</armor>
		</value>
	</Operation>

</Patch>
