<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="RT_T3485_Tank_Turret"]/projectile</xpath>
		<value>
			<projectile>Bullet_85mmTC_APHE</projectile>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="RT_T3485_Tank_Turret"]/chargePerAmmoCount</xpath>
		<value>
			<chargePerAmmoCount>1</chargePerAmmoCount>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="RT_T3485_Tank_Turret"]/genericAmmo</xpath>
		<value>
			<genericAmmo>false</genericAmmo>
		</value>
	</Operation>

	<Operation Class="PatchOperationRemove">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="RT_T3485_Tank_Turret"]/projectileShifting</xpath>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="RT_T3485_Tank_Turret"]/maxRange</xpath>
		<value>
			<maxRange>86</maxRange>
		</value>
	</Operation>

	<Operation Class="PatchOperationAddModExtension">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="RT_T3485_Tank_Turret"]</xpath>
		<value>
			<li Class="Vehicles.CETurretDataDefModExtension">
				<ammoSet>AmmoSet_85mmTC</ammoSet>
				<shotHeight>2.0</shotHeight>
				<sway>0.82</sway>
				<spread>0.01</spread>
			</li>
		</value>
	</Operation>

	<!-- Vehicle -->

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_T3485_Vehicle"]/statBases/ArmorRating_Blunt</xpath>
		<value>
			<ArmorRating_Blunt>30</ArmorRating_Blunt>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_T3485_Vehicle"]/statBases/ArmorRating_Sharp</xpath>
		<value>
			<ArmorRating_Sharp>15</ArmorRating_Sharp>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_T3485_Vehicle"]/vehicleStats/CargoCapacity</xpath>
		<value>
			<CargoCapacity>800</CargoCapacity>
		</value>
	</Operation>

	<!--Front Armor-->

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_T3485_Vehicle"]/components/li[key="FrontArmorPlating"]/health</xpath>
		<value>
			<health>600</health>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_T3485_Vehicle"]/components/li[key="FrontArmorPlating"]/armor</xpath>
		<value>
			<armor>
				<ArmorRating_Blunt>2000</ArmorRating_Blunt>
				<ArmorRating_Sharp>75</ArmorRating_Sharp>
			</armor>
		</value>
	</Operation>

	<!--Side Armor-->

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_T3485_Vehicle"]/components/li[key="LeftArmorPlating" or key="RightArmorPlating"]/health</xpath>
		<value>
			<health>450</health>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_T3485_Vehicle"]/components/li[key="LeftArmorPlating" or key="RightArmorPlating"]/armor</xpath>
		<value>
			<armor>
				<ArmorRating_Blunt>800</ArmorRating_Blunt>
				<ArmorRating_Sharp>55</ArmorRating_Sharp>
			</armor>
		</value>
	</Operation>

	<!--Roof Armor-->

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_T3485_Vehicle"]/components/li[key="RoofArmorPlating"]/health</xpath>
		<value>
			<health>350</health>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_T3485_Vehicle"]/components/li[key="RoofArmorPlating"]/armor</xpath>
		<value>
			<armor>
				<ArmorRating_Blunt>80</ArmorRating_Blunt>
				<ArmorRating_Sharp>10</ArmorRating_Sharp>
			</armor>
		</value>
	</Operation>

	<!--Rear Armor-->

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_T3485_Vehicle"]/components/li[key="BackArmorPlating"]/health</xpath>
		<value>
			<health>400</health>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_T3485_Vehicle"]/components/li[key="BackArmorPlating"]</xpath>
		<value>
			<armor>
				<ArmorRating_Blunt>800</ArmorRating_Blunt>
				<ArmorRating_Sharp>55</ArmorRating_Sharp>
			</armor>
		</value>
	</Operation>

	<!--Turret Armor-->

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_T3485_Vehicle"]/components/li[key="MainTurret"]/health</xpath>
		<value>
			<health>400</health>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_T3485_Vehicle"]/components/li[key="MainTurret"]/armor</xpath>
		<value>
			<armor>
				<ArmorRating_Blunt>3000</ArmorRating_Blunt>
				<ArmorRating_Sharp>90</ArmorRating_Sharp>
			</armor>
		</value>
	</Operation>

	<!--Various exposed metallic stuff-->

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_T3485_Vehicle"]/components/li[key="LeftTrack" or key="RightTrack"]</xpath>
		<value>
			<armor>
				<ArmorRating_Sharp>20</ArmorRating_Sharp>
				<ArmorRating_Blunt>40</ArmorRating_Blunt>
			</armor>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_T3485_Vehicle"]/components/li[key="LeftTrack" or key="RightTrack"]/health</xpath>
		<value>
			<health>200</health>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_T3485_Vehicle"]/components/li[key="LeftRoadWheels" or key="RightRoadWheels" or key="LeftDriveSprocket" or key="RightDriveSprocket" or key="LeftTensionerWheel" or key="RightTensionerWheel"]</xpath>
		<value>
			<armor>
				<ArmorRating_Sharp>20</ArmorRating_Sharp>
				<ArmorRating_Blunt>40</ArmorRating_Blunt>
			</armor>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_T3485_Vehicle"]/components/li[key="LeftRoadWheels" or key="RightRoadWheels"]/health</xpath>
		<value>
			<health>120</health>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_T3485_Vehicle"]/components/li[key="LeftDriveSprocket" or key="RightDriveSprocket"]/health</xpath>
		<value>
			<health>90</health>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_T3485_Vehicle"]/components/li[key="LeftTensionerWheel" or key="RightTensionerWheel"]/health</xpath>
		<value>
			<health>90</health>
		</value>
	</Operation>
</Patch>
