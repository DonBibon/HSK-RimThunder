<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <Vehicles.UpgradeTreeDef>
    <defName>RT_C130_Vehicle_UpgradeTree</defName>
    <nodes>
      <li>
        <key>Cargo</key>
        <label>Cargo</label>
        <description>Switch to cargo transport.</description>
        <icon>UI/cargo</icon>
        <work>1000</work>
        <gridCoordinate>(5,5)</gridCoordinate>
        <drawSize>(80, 80)</drawSize>
        <disableIfUpgradeNodeEnabled>Passenger</disableIfUpgradeNodeEnabled>
        <researchPrerequisites>
          <li>HSKV_Aviation2</li>
        </researchPrerequisites>
        <upgrades>
          <li Class="Vehicles.StatUpgrade">
            <vehicleStats>
              <li>
                <def>CargoCapacity</def>
                <value>5000</value>
              </li>
            </vehicleStats>
          </li>
          <li Class="Vehicles.VehicleUpgrade">
            <roles>
              <li>
                <key>passenger</key>
                <editKey>passengerExpansion</editKey>
                <label>Passenger</label>
                <slots>3</slots>
              </li>
            </roles>
          </li>
        </upgrades>
        <ingredients>
          <HSKV_Body_Airframe>2</HSKV_Body_Airframe>
          <VVE_CarWiring>4</VVE_CarWiring>
          <AluminiumBar>80</AluminiumBar>
          <AdvMechanism>6</AdvMechanism>
        </ingredients>
      </li>
      <li>
        <key>Passenger</key>
        <label>Passenger</label>
        <description>Switch to passenger transport.</description>
        <icon>UI/passenger</icon>
        <work>1000</work>
        <gridCoordinate>(5,10)</gridCoordinate>
        <drawSize>(80, 80)</drawSize>
        <disableIfUpgradeNodeEnabled>Cargo</disableIfUpgradeNodeEnabled>
        <researchPrerequisites>
          <li>HSKV_Aviation2</li>
        </researchPrerequisites>
        <upgrades>
          <li Class="Vehicles.StatUpgrade">
            <vehicleStats>
              <li>
                <def>CargoCapacity</def>
                <value>-12000</value>
              </li>
            </vehicleStats>
          </li>
          <li Class="Vehicles.VehicleUpgrade">
            <roles>
              <li>
                <key>passenger</key>
                <editKey>passengerExpansion</editKey>
                <label>Passenger</label>
                <slots>64</slots>
              </li>
            </roles>
          </li>
        </upgrades>
        <ingredients>
          <HSKV_Body_Airframe>2</HSKV_Body_Airframe>
          <Cloth>150</Cloth>
          <Plastic>50</Plastic>
          <AluminiumBar>60</AluminiumBar>
        </ingredients>
      </li>
    </nodes>
  </Vehicles.UpgradeTreeDef>

