<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>blakil.vehiclesceoverhaul</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationAdd">
					<xpath>Defs/VehiclesCEOverhaul.VehicleRaidTuningDef[defName="VCEO_VehicleRaidTuning"]/adaptedVehicles</xpath>
					<value>
						<li>RT_C130_Vehicle</li>
						<li>RT_CH53E_Vehicle</li>
						<li>RT_UH60_Vehicle</li>
					</value>
				</li>
				<li Class="PatchOperationAddModExtension">
					<xpath>Defs/Vehicles.VehicleDef[defName="RT_C130_Vehicle"]</xpath>
					<value>
						<li Class="VehiclesCEOverhaul.VehicleRaidExtension">
							<mode>Off</mode>
						</li>
						<li Class="VehiclesCEOverhaul.VehicleRaidRoleExtension">
							<role>None</role>
						</li>
					</value>
				</li>
				<li Class="PatchOperationAddModExtension">
					<xpath>Defs/Vehicles.VehicleDef[defName="RT_CH53E_Vehicle"]</xpath>
					<value>
						<li Class="VehiclesCEOverhaul.VehicleRaidExtension">
							<mode>Off</mode>
						</li>
						<li Class="VehiclesCEOverhaul.VehicleRaidRoleExtension">
							<role>None</role>
						</li>
					</value>
				</li>
				<li Class="PatchOperationAddModExtension">
					<xpath>Defs/Vehicles.VehicleDef[defName="RT_UH60_Vehicle"]</xpath>
					<value>
						<li Class="VehiclesCEOverhaul.VehicleRaidExtension">
							<mode>Off</mode>
						</li>
						<li Class="VehiclesCEOverhaul.VehicleRaidRoleExtension">
							<role>None</role>
						</li>
					</value>
				</li>
			</operations>
		</match>
	</Operation>
</Patch>
