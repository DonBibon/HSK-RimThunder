<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- Turret -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="RT_M2A3_Tank_Turret"]/projectile</xpath>
		<value>
			<projectile>Bullet_25x137mmNATO_AP</projectile>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="RT_M2A3_Tank_Turret"]/reloadTimer</xpath>
		<value>
			<reloadTimer>12.7</reloadTimer>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="RT_M2A3_Tank_Turret"]/warmUpTimer</xpath>
		<value>
			<warmUpTimer>1.5</warmUpTimer>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="RT_M2A3_Tank_Turret"]/chargePerAmmoCount</xpath>
		<value>
			<chargePerAmmoCount>1</chargePerAmmoCount>
		</value>
	</Operation>

	<Operation Class="PatchOperationRemove">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="RT_M2A3_Tank_Turret"]/projectileShifting</xpath>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="RT_M2A3_Tank_Turret"]/maxRange</xpath>
		<value>
			<maxRange>70</maxRange>
		</value>
	</Operation>

	<Operation Class="PatchOperationAddModExtension">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="RT_M2A3_Tank_Turret"]</xpath>
		<value>
			<li Class="Vehicles.CETurretDataDefModExtension">
				<ammoSet>AmmoSet_25x137mmNATO</ammoSet>
				<shotHeight>2.0</shotHeight>
				<sway>0.82</sway>
				<spread>0.01</spread>
			</li>
		</value>
	</Operation>
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="RT_M2A3_Tank_Turret"]/ammunition</xpath>
		<match Class="PatchOperationReplace">
			<xpath>Defs/Vehicles.VehicleTurretDef[defName="RT_M2A3_Tank_Turret"]/ammunition</xpath>
			<value>
				<ammunition Inherit="False">
					<thingDefs>
						<li>Ammo_25x137mmNATO_AP</li>
						<li>Ammo_25x137mmNATO_Incendiary</li>
						<li>Ammo_25x137mmNATO_HE</li>
						<li>Ammo_25x137mmNATO_Sabot</li>
					</thingDefs>
				</ammunition>
			</value>
		</match>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/Vehicles.VehicleTurretDef[defName="RT_M2A3_Tank_Turret"]</xpath>
			<value>
				<ammunition Inherit="False">
					<thingDefs>
						<li>Ammo_25x137mmNATO_AP</li>
						<li>Ammo_25x137mmNATO_Incendiary</li>
						<li>Ammo_25x137mmNATO_HE</li>
						<li>Ammo_25x137mmNATO_Sabot</li>
					</thingDefs>
				</ammunition>
			</value>
		</nomatch>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="RT_TOW2A_Turret"]/projectile</xpath>
		<value>
			<projectile>Bullet_TOW2_HEAT</projectile>
