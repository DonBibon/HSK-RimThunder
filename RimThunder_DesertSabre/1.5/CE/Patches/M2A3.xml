		</value>
	</Operation>
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="RT_TOW2A_Turret"]/ammunition</xpath>
		<match Class="PatchOperationReplace">
			<xpath>Defs/Vehicles.VehicleTurretDef[defName="RT_TOW2A_Turret"]/ammunition</xpath>
			<value>
				<ammunition Inherit="False">
					<thingDefs>
						<li>Ammo_TOW2_HEAT</li>
					</thingDefs>
				</ammunition>
			</value>
		</match>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/Vehicles.VehicleTurretDef[defName="RT_TOW2A_Turret"]</xpath>
			<value>
				<ammunition Inherit="False">
					<thingDefs>
						<li>Ammo_TOW2_HEAT</li>
					</thingDefs>
				</ammunition>
			</value>
		</nomatch>
	</Operation>

