  <!-- ================== Projectiles ================== -->
  <ThingDef ParentName="Base120mmCannonShell">
    <defName>Bullet_120mmTC_HEAT</defName>
    <label>120mm M830 cannon shell (HEAT)</label>
    <graphicData>
      <texPath>Things/Projectile/Ammo_M830</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile Class="CombatExtended.ProjectilePropertiesCE">
      <damageDef>Bullet</damageDef>
      <damageAmountBase>350</damageAmountBase>
      <soundExplode>MortarBomb_Explode</soundExplode>
      <armorPenetrationSharp>440</armorPenetrationSharp>
      <armorPenetrationBlunt>70</armorPenetrationBlunt>
    </projectile>
    <comps>
      <li Class="CombatExtended.CompProperties_ExplosiveCE">
        <damageAmountBase>280</damageAmountBase>
        <explosiveDamageType>Bomb</explosiveDamageType>
        <explosiveRadius>3.2</explosiveRadius>
        <applyDamageToExplosionCellsNeighbors>true</applyDamageToExplosionCellsNeighbors>
      </li>
      <li Class="CombatExtended.CompProperties_Fragments">
        <fragments>
          <Fragment_Large>24</Fragment_Large>
          <Fragment_Small>40</Fragment_Small>
        </fragments>
      </li>
    </comps>
  </ThingDef>
  <ThingDef ParentName="Base120mmCannonShell">
    <defName>Bullet_120mmTC_Sabot</defName>
