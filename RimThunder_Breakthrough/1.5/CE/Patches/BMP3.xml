	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="RT_BMP3_Tank_Turret"]/projectile</xpath>
		<value>
			<projectile>Bullet_100mmShell_HE</projectile>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="RT_BMP3_Tank_Turret"]/chargePerAmmoCount</xpath>
		<value>
			<chargePerAmmoCount>1</chargePerAmmoCount>
		</value>
	</Operation>

