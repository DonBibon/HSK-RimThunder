<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- Turret -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="2S38_Tank_Turret"]/projectile</xpath>
		<value>
			<projectile>Bullet_57x348sr_HE</projectile>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="2S38_Tank_Turret"]/chargePerAmmoCount</xpath>
		<value>
			<chargePerAmmoCount>1</chargePerAmmoCount>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="2S38_Tank_Turret"]/genericAmmo</xpath>
		<value>
			<genericAmmo>false</genericAmmo>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="2S38_Tank_Turret"]/reloadTimer</xpath>
		<value>
			<reloadTimer>6</reloadTimer>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="2S38_Tank_Turret"]/warmUpTimer</xpath>
		<value>
			<warmUpTimer>1.3</warmUpTimer>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="2S38_Tank_Turret"]/magazineCapacity</xpath>
		<value>
			<magazineCapacity>50</magazineCapacity>
		</value>
	</Operation>

	<Operation Class="PatchOperationRemove">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="2S38_Tank_Turret"]/projectileShifting</xpath>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="2S38_Tank_Turret"]/maxRange</xpath>
		<value>
			<maxRange>72</maxRange>
		</value>
	</Operation>

	<Operation Class="PatchOperationAddModExtension">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="2S38_Tank_Turret"]</xpath>
		<value>
			<li Class="Vehicles.CETurretDataDefModExtension">
				<ammoSet>AmmoSet_57x348sr</ammoSet>
				<shotHeight>2.0</shotHeight>
				<sway>0.82</sway>
				<spread>0.01</spread>
			</li>
		</value>
	</Operation>
</Patch>