			<xpath>Defs/Vehicles.VehicleTurretDef[defName="BMPT_Tank_Turret"]/ammunition</xpath>
			<value>
				<ammunition Inherit="False">
					<thingDefs>
						<li>Ammo_30x165mm_AP</li>
						<li>Ammo_30x165mm_Incendiary</li>
						<li>Ammo_30x165mm_HE</li>
						<li>Ammo_30x165mm_Sabot</li>
					</thingDefs>
				</ammunition>
			</value>
