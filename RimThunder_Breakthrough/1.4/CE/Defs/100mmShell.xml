<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<ThingCategoryDef>
		<defName>Ammo100mmShell</defName>
		<label>100mm Shell</label>
		<parent>AmmoRockets</parent>
		<iconPath>UI/Icons/ThingCategories/CaliberRocket</iconPath>
	</ThingCategoryDef>

	<!-- ==================== AmmoSet ========================== -->

	<CombatExtended.AmmoSetDef>
		<defName>AmmoSet_100mmShell</defName>
		<label>100mm Shell</label>
		<ammoTypes>
			<Ammo_100mmShell_HE>Bullet_100mmShell_HE</Ammo_100mmShell_HE>
			<Ammo_100mmShell_HEAT>Bullet_100mmShell_HEAT</Ammo_100mmShell_HEAT>
        </ammoTypes>
	</CombatExtended.AmmoSetDef>

	<!-- ==================== Ammo ========================== -->

	<ThingDef Class="CombatExtended.AmmoDef" Name="100mmShell" ParentName="MediumAmmoBase" Abstract="True">
		<description>100mm 2A70 low bore pressure cannon ammunition.</description>
		<statBases>
			<MaxHitPoints>150</MaxHitPoints>
		</statBases>
		<tradeTags>
			<li>CE_AutoEnableTrade</li>
			<li>CE_AutoEnableCrafting_TableHeavyAmmunition</li>
		</tradeTags>
		<thingCategories>
			<li>Ammo100mmShell</li>
		</thingCategories>
		<stackLimit>25</stackLimit>
		<cookOffFlashScale>40</cookOffFlashScale>
		<cookOffSound>MortarBomb_Explode</cookOffSound>
	</ThingDef>

	<ThingDef Class="CombatExtended.AmmoDef" ParentName="100mmShell">
		<defName>Ammo_100mmShell_HE</defName>
		<label>3UOF19 (HE)</label>
		<graphicData>
			<texPath>Things/Ammo/Cannon/Tank/HE</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>
		<statBases>
			<MarketValue>52.78</MarketValue>
			<Mass>2.8</Mass>
			<Bulk>7.14</Bulk>
		</statBases>
		<ammoClass>RocketHE</ammoClass>
		<detonateProjectile>Bullet_100mmShell_HE</detonateProjectile>
	</ThingDef>

	<ThingDef Class="CombatExtended.AmmoDef" ParentName="100mmShell">
		<defName>Ammo_100mmShell_HEAT</defName>
		<label>9M117M (HEAT)</label>
		<graphicData>
			<texPath>Things/Ammo/Rocket/SPG9/HEAT</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>
		<statBases>
			<MarketValue>104.58</MarketValue>
			<Mass>4.7</Mass>
			<Bulk>8.61</Bulk>
		</statBases>
		<ammoClass>RocketHEAT</ammoClass>
		<detonateProjectile>Bullet_100mmShell_HEAT</detonateProjectile>
	</ThingDef>

	<!-- ================== Projectiles ================== -->

	<ThingDef Name="Base100mmShell" ParentName="BaseExplosiveBullet" Abstract="true">
		<graphicData>
			<shaderType>TransparentPostLight</shaderType>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<speed>43</speed>
			<soundExplode>MortarBomb_Explode</soundExplode>
			<flyOverhead>true</flyOverhead>
			<dropsCasings>true</dropsCasings>
			<casingMoteDefname>Fleck_BigShell</casingMoteDefname>
			<casingFilthDefname>Filth_CannonAmmoCasings</casingFilthDefname>
		</projectile>
	</ThingDef>

	<ThingDef ParentName="Base100mmShell">
		<defName>Bullet_100mmShell_HE</defName>
		<label>3UOF19 Shell (HE)</label>
		<graphicData>
			<texPath>Things/Projectile/Cannon/HE</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<explosionRadius>3.9</explosionRadius>
			<damageDef>Bomb</damageDef>
			<armorPenetrationSharp>0</armorPenetrationSharp>
			<damageAmountBase>125</damageAmountBase>
			<armorPenetrationBlunt>0</armorPenetrationBlunt>
			<applyDamageToExplosionCellsNeighbors>true</applyDamageToExplosionCellsNeighbors>
		</projectile>
		<comps>
			<li Class="CombatExtended.CompProperties_Fragments">
				<fragments>
					<Fragment_Large>12</Fragment_Large>
					<Fragment_Small>34</Fragment_Small>
				</fragments>
			</li>
		</comps>
	</ThingDef>

	<ThingDef ParentName="Base100mmShell">
		<defName>Bullet_100mmShell_HEAT</defName>
		<label>9M117M Missile (HEAT)</label>
		<thingClass>CombatExtended.ProjectileCE_Explosive</thingClass>
		<graphicData>
			<texPath>Things/Projectile/Rocket/SPG9/HEAT</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<damageDef>Bullet</damageDef>
			<damageAmountBase>275</damageAmountBase>
			<armorPenetrationSharp>650</armorPenetrationSharp>
			<armorPenetrationBlunt>44.956</armorPenetrationBlunt>
		</projectile>
		<comps>
			<li Class="CombatExtended.CompProperties_ExplosiveCE">
				<damageAmountBase>150</damageAmountBase>
				<explosiveDamageType>Bomb</explosiveDamageType>
				<explosiveRadius>1.5</explosiveRadius>
				<explosionSound>MortarBomb_Explode</explosionSound>
				<applyDamageToExplosionCellsNeighbors>true</applyDamageToExplosionCellsNeighbors>
			</li>
			<li Class="CombatExtended.CompProperties_Fragments">
				<fragments>
					<Fragment_Large>3</Fragment_Large>
					<Fragment_Small>12</Fragment_Small>
				</fragments>
			</li>
			<li Class="CombatExtended.CompProperties_ProjectileFleck">
				<FleckDatas>
					<li>
						<fleck>Fleck_CERocketFlame</fleck>
						<emissionsPerTick>7</emissionsPerTick>
						<flecksPerEmission>3</flecksPerEmission>
						<scale>1</scale>
						<cutoffTickRange>25~30</cutoffTickRange>
						<originOffset>0.4</originOffset>
					</li>
					<li>
						<fleck>Fleck_CERocketSmokeTrail</fleck>
						<emissionsPerTick>2</emissionsPerTick>
						<rotation>0~360</rotation>
						<scale>0.5</scale>
						<flecksPerEmission>1</flecksPerEmission>
					</li>
					<li>
						<fleck>Fleck_CERocketSmoke</fleck>
						<emissionsPerTick>2</emissionsPerTick>
						<rotation>0~360</rotation>
						<flecksPerEmission>2</flecksPerEmission>
						<cutoffTickRange>25~60</cutoffTickRange>
					</li>
				</FleckDatas>
			</li>
		</comps>
	</ThingDef>

	<!-- ==================== Recipes ========================== -->

	<RecipeDef ParentName="LauncherAmmoRecipeBase">
		<defName>MakeAmmo_100mmShell_HE</defName>
		<label>make 3UOF19 HE Shell x5</label>
		<description>Craft 5 3UOF19 HE Shell.</description>
		<jobString>Making 3UOF19 HE Shell.</jobString>
		<workAmount>9200</workAmount>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Steel</li>
					</thingDefs>
				</filter>
				<count>28</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>FSX</li>
					</thingDefs>
				</filter>
				<count>10</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Chemfuel</li>
					</thingDefs>
				</filter>
				<count>35</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>Steel</li>
				<li>FSX</li>
				<li>Chemfuel</li>
			</thingDefs>
		</fixedIngredientFilter>
		<products>
			<Ammo_100mmShell_HE>5</Ammo_100mmShell_HE>
		</products>
	    <researchPrerequisite>RT_ModernIFV</researchPrerequisite>
  </RecipeDef>

	<RecipeDef ParentName="LauncherAmmoRecipeBase">
		<defName>MakeAmmo_100mmShell_HEAT</defName>
		<label>make 9M117M Missile x5</label>
		<description>Craft 5 9M117M Missile.</description>
		<jobString>Making 9M117M Missile.</jobString>
		<workAmount>20400</workAmount>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Steel</li>
					</thingDefs>
				</filter>
				<count>28</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>FSX</li>
					</thingDefs>
				</filter>
				<count>10</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>ComponentIndustrial</li>
					</thingDefs>
				</filter>
				<count>4</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>Steel</li>
				<li>FSX</li>
				<li>ComponentIndustrial</li>
			</thingDefs>
		</fixedIngredientFilter>
		<products>
			<Ammo_100mmShell_HEAT>5</Ammo_100mmShell_HEAT>
		</products>
	    <researchPrerequisite>RT_ModernIFV</researchPrerequisite>
  </RecipeDef>

</Defs>