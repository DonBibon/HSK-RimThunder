<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingCategoryDef>
    <defName>Ammo57mmAC</defName>
    <label>57mm AC</label>
    <parent>AmmoHighCaliber</parent>
    <iconPath>UI/Icons/ThingCategories/CaliberAutocannonLarge</iconPath>
  </ThingCategoryDef>
  <!-- ==================== AmmoSet ========================== -->
  <CombatExtended.AmmoSetDef>
    <defName>AmmoSet_57mmAC</defName>
    <label>57mm AC</label>
    <ammoTypes>
      <Ammo_3OF91_HE>Bullet_3OF91_HE</Ammo_3OF91_HE>
      <Ammo_3UBM21_Sabot>Bullet_3UBM21_Sabot</Ammo_3UBM21_Sabot>
    </ammoTypes>
  </CombatExtended.AmmoSetDef>
  <!-- ==================== Ammo ========================== -->
  <ThingDef Class="CombatExtended.AmmoDef" Name="Ammo57mmACBase" ParentName="MediumAmmoBase" Abstract="True">
    <description>Large caliber cartridge used by autocannons.</description>
    <statBases>
      <Mass>0.775</Mass>
      <Bulk>0.45</Bulk>
    </statBases>
    <tradeTags>
      <li>CE_AutoEnableTrade</li>
      <li>CE_AutoEnableCrafting</li>
    </tradeTags>
    <thingCategories>
      <li>Ammo57mmAC</li>
    </thingCategories>
    <stackLimit>500</stackLimit>
  </ThingDef>
  <ThingDef Class="CombatExtended.AmmoDef" ParentName="Ammo57mmACBase">
    <defName>Ammo_3OF91_HE</defName>
    <label>57mm 3OF91 (AP-HE)</label>
    <graphicData>
      <texPath>Things/Ammo/57mmAC/APHE</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>6.24</MarketValue>
    </statBases>
    <ammoClass>ExplosiveAP</ammoClass>
    <cookOffProjectile>Bullet_3OF91_HE</cookOffProjectile>
  </ThingDef>
  <ThingDef Class="CombatExtended.AmmoDef" ParentName="Ammo57mmACBase">
    <defName>Ammo_3UBM21_Sabot</defName>
    <label>57mm 3UBM21 APDS (Sabot)</label>
    <graphicData>
      <texPath>Things/Ammo/57mmAC/APDS</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <Mass>0.665</Mass>
      <MarketValue>3.81</MarketValue>
    </statBases>
    <ammoClass>Sabot</ammoClass>
    <cookOffProjectile>Bullet_3UBM21_Sabot</cookOffProjectile>
  </ThingDef>
  <!-- ================== Projectiles ================== -->
  <ThingDef Name="Base57mmAC" ParentName="BaseBulletCE" Abstract="true">
    <graphicData>
      <texPath>Things/Projectile/Bullet_Big</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile Class="CombatExtended.ProjectilePropertiesCE">
      <speed>100</speed>
      <flyOverhead>false</flyOverhead>
      <dropsCasings>true</dropsCasings>
      <casingMoteDefname>Fleck_BigShell</casingMoteDefname>
      <casingFilthDefname>Filth_CannonAmmoCasings</casingFilthDefname>
    </projectile>
  </ThingDef>
  <ThingDef ParentName="Base57mmAC">
    <defName>Bullet_3OF91_HE</defName>
    <label>57mm 3OF91 (HE)</label>
    <projectile Class="CombatExtended.ProjectilePropertiesCE">
      <explosionRadius>3</explosionRadius>
      <damageDef>Bomb</damageDef>
      <armorPenetrationSharp>0</armorPenetrationSharp>
      <damageAmountBase>108</damageAmountBase>
      <armorPenetrationBlunt>0</armorPenetrationBlunt>
      <applyDamageToExplosionCellsNeighbors>true</applyDamageToExplosionCellsNeighbors>
    </projectile>
    <comps>
      <li Class="CombatExtended.CompProperties_Fragments">
        <fragments>
          <Fragment_Large>9</Fragment_Large>
          <Fragment_Small>18</Fragment_Small>
        </fragments>
      </li>
    </comps>
  </ThingDef>
  <ThingDef ParentName="Base57mmAC">
    <defName>Bullet_3UBM21_Sabot</defName>
    <label>57mm 3UBM21 APDS (Sabot)</label>
    <projectile Class="CombatExtended.ProjectilePropertiesCE">
      <speed>180</speed>
      <damageDef>Bullet</damageDef>
      <damageAmountBase>162</damageAmountBase>
      <armorPenetrationSharp>170</armorPenetrationSharp>
      <armorPenetrationBlunt>23000</armorPenetrationBlunt>
    </projectile>
  </ThingDef>
  <!-- ==================== Recipes ========================== -->
