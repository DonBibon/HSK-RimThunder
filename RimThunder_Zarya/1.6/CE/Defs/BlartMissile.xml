<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<ThingCategoryDef>
		<defName>AmmoMini_Missile</defName>
		<label>"Blart" mini missile</label>
		<parent>AmmoMissiles</parent>
		<iconPath>Things/UI/Icons/Ammo_MiniMissile</iconPath>
	</ThingCategoryDef>

	<!-- ==================== AmmoSet ========================== -->

	<CombatExtended.AmmoSetDef>
		<defName>AmmoSet_Mini_Missile</defName>
		<label>"Blart" mini missile</label>
		<ammoTypes>
			<Ammo_Mini_Missile_Thermobaric>Bullet_Mini_MissileThermobaric</Ammo_Mini_Missile_Thermobaric>
		</ammoTypes>
	</CombatExtended.AmmoSetDef>

	<!-- ==================== Ammo ========================== -->

	<ThingDef Class="CombatExtended.AmmoDef" Name="MiniMBase" ParentName="MediumAmmoBase" Abstract="True">
		<thingCategories>
			<li>AmmoMini_Missile</li>
		</thingCategories>
		<stackLimit>25</stackLimit>
		<tradeTags>
			<li>CE_AutoEnableTrade</li>
			<li>CE_AutoEnableCrafting_TableHeavyAmmunition</li>
		</tradeTags>
		<statBases>
			<MaxHitPoints>200</MaxHitPoints>
			<Mass>5</Mass>
			<Bulk>10</Bulk>
		</statBases>
		<cookOffFlashScale>30</cookOffFlashScale>
		<cookOffSound>MortarBomb_Explode</cookOffSound>
		<isMortarAmmo>true</isMortarAmmo>
	</ThingDef>

	<ThingDef Class="CombatExtended.AmmoDef" ParentName="MiniMBase">
		<defName>Ammo_Mini_Missile_Thermobaric</defName>
		<label>"Blart" mini missile(Thermobaric)</label>
		<graphicData>
			<texPath>Things/Ammo/Mini_Missile</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>
		<statBases>
			<MarketValue>120</MarketValue>
		</statBases>
		<ammoClass>RocketThermobaric</ammoClass>
		<detonateProjectile>Bullet_Mini_MissileThermobaric</detonateProjectile>
	</ThingDef>



	<!-- ================== Projectiles ================== -->

	<ThingDef Name="BaseMiniM" ParentName="BaseExplosiveBullet" Abstract="true">
		<graphicData>
			<shaderType>TransparentPostLight</shaderType>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<speed>45</speed>
			<soundAmbient>RocketPropelledLoop_Small</soundAmbient>
		</projectile>
		<comps>
			<li Class="CombatExtended.CompProperties_ProjectileFleck">
				<FleckDatas>
					<li>
						<fleck>Fleck_CERocketFlame</fleck>
						<emissionsPerTick>7</emissionsPerTick>
						<flecksPerEmission>3</flecksPerEmission>
						<scale>1.5</scale>
						<cutoffTickRange>25~60</cutoffTickRange>
						<originOffset>0.4</originOffset>
					</li>
					<li>
						<fleck>Fleck_CERocketSmokeTrail</fleck>
						<emissionsPerTick>1</emissionsPerTick>
						<rotation>0~360</rotation>
						<scale>3</scale>
						<flecksPerEmission>1</flecksPerEmission>
					</li>
					<li>
						<fleck>Fleck_CERocketSmoke</fleck>
						<emissionsPerTick>2</emissionsPerTick>
						<rotation>0~360</rotation>
						<scale>2</scale>
						<flecksPerEmission>1</flecksPerEmission>
						<cutoffTickRange>25~60</cutoffTickRange>
					</li>
				</FleckDatas>
			</li>
		</comps>
	</ThingDef>

	<ThingDef ParentName="BaseMiniM">
		<defName>Bullet_Mini_MissileThermobaric</defName>
		<label>"Blart" mini missile (Thermobaric)</label>
		<graphicData>
			<texPath>Things/Projectile/Mini_Missile</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>0.8</drawSize>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<damageDef>Thermobaric</damageDef>
			<damageAmountBase>275</damageAmountBase>
			<explosionRadius>3.5</explosionRadius>
			<preExplosionSpawnThingDef>Filth_Fuel</preExplosionSpawnThingDef>
			<preExplosionSpawnChance>0.6</preExplosionSpawnChance>
			<armorPenetrationSharp>0</armorPenetrationSharp>
			<armorPenetrationBlunt>0</armorPenetrationBlunt>
			<applyDamageToExplosionCellsNeighbors>true</applyDamageToExplosionCellsNeighbors>
			<ai_IsIncendiary>true</ai_IsIncendiary>
		</projectile>
	</ThingDef>



	<!-- ==================== Recipes ========================== -->
	<RecipeDef ParentName="LauncherAmmoRecipeBase">
		<defName>MakeAmmo_Mini_Missile_Thermobaric</defName>
		<label>Make "Blart" mini Missiles x25</label>
		<description>Craft 25 "Blart" mini Missiles.</description>
		<jobString>Making 25 "Blart" mini Missiles.</jobString>
		<workAmount>18800</workAmount>
		<researchPrerequisite>RT_ModernIFV</researchPrerequisite>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Steel</li>
					</thingDefs>
				</filter>
				<count>300</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>FSX</li>
					</thingDefs>
				</filter>
				<count>125</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Prometheum</li>
					</thingDefs>
				</filter>
				<count>25</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>Steel</li>
				<li>FSX</li>
				<li>Prometheum</li>
			</thingDefs>
		</fixedIngredientFilter>
		<products>
			<Ammo_Mini_Missile_Thermobaric>25</Ammo_Mini_Missile_Thermobaric>
		</products>
		<skillRequirements>
			<Crafting>6</Crafting>
		</skillRequirements>
	</RecipeDef>



</Defs>
