	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_Kurganets25_Vehicle"]/components/li[key="LeftRoadWheels" or key="RightRoadWheels"]/health</xpath>
