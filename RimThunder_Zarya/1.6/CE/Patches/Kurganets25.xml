<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- Turret -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="RT_KPVT_Turret"]/projectile</xpath>
		<value>
			<projectile>Bullet_145x114mm_Incendiary</projectile>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="RT_KPVT_Turret"]/chargePerAmmoCount</xpath>
		<value>
			<chargePerAmmoCount>1</chargePerAmmoCount>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="RT_KPVT_Turret"]/genericAmmo</xpath>
		<value>
			<genericAmmo>false</genericAmmo>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="RT_HCBT_Turret"]/reloadTimer</xpath>
		<value>
			<reloadTimer>8</reloadTimer>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="RT_KPVT_Turret"]/maxRange</xpath>
		<value>
			<maxRange>72</maxRange>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="RT_KPVT_Turret"]/shotSound</xpath>
		<value>
			<shotSound>HeavyMG</shotSound>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="RT_KPVT_Turret"]/warmUpTimer</xpath>
		<value>
			<warmUpTimer>1.3</warmUpTimer>
		</value>
	</Operation>

	<Operation Class="PatchOperationAddModExtension">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="RT_KPVT_Turret"]</xpath>
		<value>
			<li Class="Vehicles.CETurretDataDefModExtension">
				<ammoSet>AmmoSet_145x114mm</ammoSet>
				<shotHeight>1.8</shotHeight>
				<sway>0.82</sway>
				<spread>0.01</spread>
			</li>
		</value>
	</Operation>
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="RT_KPVT_Turret"]/ammunition</xpath>
		<match Class="PatchOperationReplace">
			<xpath>Defs/Vehicles.VehicleTurretDef[defName="RT_KPVT_Turret"]/ammunition</xpath>
			<value>
				<ammunition Inherit="False">
					<thingDefs>
						<li>Ammo_145x114mm_FMJ</li>
						<li>Ammo_145x114mm_Incendiary</li>
						<li>Ammo_145x114mm_HE</li>
						<li>Ammo_145x114mm_AP</li>
						<li>Ammo_145x114mm_Sabot</li>
					</thingDefs>
				</ammunition>
			</value>
		</match>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/Vehicles.VehicleTurretDef[defName="RT_KPVT_Turret"]</xpath>
			<value>
				<ammunition Inherit="False">
					<thingDefs>
						<li>Ammo_145x114mm_FMJ</li>
						<li>Ammo_145x114mm_Incendiary</li>
						<li>Ammo_145x114mm_HE</li>
						<li>Ammo_145x114mm_AP</li>
						<li>Ammo_145x114mm_Sabot</li>
					</thingDefs>
				</ammunition>
			</value>
		</nomatch>
	</Operation>


	<!-- Vehicle -->

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_Kurganets25_Vehicle"]</xpath>
		<value>
			<descriptionHyperlinks>
				<CombatExtended.AmmoSetDef>AmmoSet_145x114mm</CombatExtended.AmmoSetDef>
				<CombatExtended.AmmoSetDef>AmmoSet_30x173mm</CombatExtended.AmmoSetDef>
				<CombatExtended.AmmoSetDef>AmmoSet_762x54mmR</CombatExtended.AmmoSetDef>
				<CombatExtended.AmmoSetDef>AmmoSet_9M133M</CombatExtended.AmmoSetDef>
				<CombatExtended.AmmoSetDef>AmmoSet_57x348sr</CombatExtended.AmmoSetDef>
				<ThingDef>Ammo_40x46mmGrenade_Smoke</ThingDef>
			</descriptionHyperlinks>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_Kurganets25_Vehicle"]/statBases/ArmorRating_Blunt</xpath>
		<value>
			<ArmorRating_Blunt>10</ArmorRating_Blunt>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
