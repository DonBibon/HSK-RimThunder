	<Operation Class="PatchOperationAddModExtension">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="RT_Min_Missile_Turret"]</xpath>
		<value>
			<li Class="Vehicles.CETurretDataDefModExtension">
				<ammoSet>AmmoSet_Mini_Missile</ammoSet>
				<shotHeight>1.9</shotHeight>
				<sway>0.94</sway>
				<spread>0.02</spread>
				<recoil>1.5</recoil>
			</li>
		</value>
	</Operation>

