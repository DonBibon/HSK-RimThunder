<?xml version="1.0" encoding="utf-8"?>
<Patch>
	
	<!-- Vehicle -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_TyphoonVDV_Vehicle"]</xpath>
		<value>
			<descriptionHyperlinks>
				<CombatExtended.AmmoSetDef>AmmoSet_30x173mm</CombatExtended.AmmoSetDef>
				<CombatExtended.AmmoSetDef>AmmoSet_81mmMortarShell</CombatExtended.AmmoSetDef>
				<CombatExtended.AmmoSetDef>AmmoSet_9M133M</CombatExtended.AmmoSetDef>
				<CombatExtended.AmmoSetDef>AmmoSet_30x29mmGrenade</CombatExtended.AmmoSetDef>
				<CombatExtended.AmmoSetDef>AmmoSet_762x54mmR</CombatExtended.AmmoSetDef>
			</descriptionHyperlinks>
		</value>
	</Operation>
	
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_TyphoonVDV_Vehicle"]/statBases/ArmorRating_Blunt</xpath>
		<value>
			<ArmorRating_Blunt>100</ArmorRating_Blunt>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_TyphoonVDV_Vehicle"]/statBases/ArmorRating_Sharp</xpath>
		<value>
			<ArmorRating_Sharp>40</ArmorRating_Sharp>
		</value>
	</Operation>

	<!--Roof Armor-->

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_TyphoonVDV_Vehicle"]/components/li[key="EngineHood" or key="Roof"]/health</xpath>
		<value>
			<health>200</health>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_TyphoonVDV_Vehicle"]/components/li[key="EngineHood" or key="Roof"]/armor</xpath>
		<value>
			<armor>
				<ArmorRating_Blunt>200</ArmorRating_Blunt>
				<ArmorRating_Sharp>24</ArmorRating_Sharp>
			</armor>
		</value>
	</Operation>

	<!--Rear Armor-->

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_TyphoonVDV_Vehicle"]/components/li[key="LeftDoorPanel" or key="RightDoorPanel" or key="FrontBumper" or key="RearBumper"]/health</xpath>
		<value>
			<health>200</health>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_TyphoonVDV_Vehicle"]/components/li[key="LeftDoorPanel" or key="RightDoorPanel" or key="FrontBumper" or key="RearBumper"]/armor</xpath>
		<value>
			<armor>
				<ArmorRating_Blunt>600</ArmorRating_Blunt>
				<ArmorRating_Sharp>40</ArmorRating_Sharp>
			</armor>
		</value>
	</Operation>

	<!--Various exposed metallic stuff-->

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_TyphoonVDV_Vehicle"]/components/li[key="LeftFrontWheel" or key="RightFrontWheel" or key="LeftRearWheel" or key="RightRearWheel"]/armor</xpath>
		<value>
			<armor>
				<ArmorRating_Sharp>10</ArmorRating_Sharp>
				<ArmorRating_Blunt>60</ArmorRating_Blunt>
			</armor>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleDef[defName="RT_TyphoonVDV_Vehicle"]/components/li[key="LeftFrontWheel" or key="RightFrontWheel" or key="LeftRearWheel" or key="RightRearWheel"]/health</xpath>
		<value>
			<health>120</health>
		</value>
	</Operation>
</Patch>
