<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<ThingCategoryDef>
		<defName>Ammo57x480mmR</defName>
		<label>57x480mmR</label>
		<parent>AmmoShells</parent>
		<iconPath>UI/Icons/ThingCategories/CaliberAutocannonLarge</iconPath>
	</ThingCategoryDef>

	<!-- ==================== AmmoSet ========================== -->

	<CombatExtended.AmmoSetDef>
		<defName>AmmoSet_57x480mmR</defName>
		<label>57x480mmR</label>
		<ammoTypes>
			<Ammo_57x480mmR_AP>Bullet_57x480mmR_AP</Ammo_57x480mmR_AP>
			<Ammo_57x480mmR_HE>Bullet_57x480mmR_HE</Ammo_57x480mmR_HE>
		</ammoTypes>
	</CombatExtended.AmmoSetDef>

	<!-- ==================== Ammo ========================== -->

	<ThingDef Class="CombatExtended.AmmoDef" Name="Ammo57x480mmRBase" ParentName="HeavyAmmoBase" Abstract="True">
		<description>Large caliber shell used by light antitank guns.</description>
		<thingCategories>
			<li>Ammo57x480mmR</li>
		</thingCategories>
		<stackLimit>25</stackLimit>
		<tradeTags>
			<li>CE_AutoEnableTrade</li>
			<li>CE_AutoEnableCrafting_TableMachining</li>
		</tradeTags>
		<cookOffFlashScale>20</cookOffFlashScale>
		<cookOffSound>MortarBomb_Explode</cookOffSound>
	</ThingDef>

	<ThingDef Class="CombatExtended.AmmoDef" ParentName="Ammo57x480mmRBase">
		<defName>Ammo_57x480mmR_AP</defName>
		<label>57x480mmR cartridge (APHE)</label>
		<graphicData>
			<texPath>Things/Ammo/Cannon/Tank/APHE</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>
		<statBases>
			<Mass>6.5</Mass>
			<MarketValue>17.2</MarketValue>
		</statBases>
		<ammoClass>ArmorPiercing</ammoClass>
		<detonateProjectile>Bullet_57x480mmR_AP</detonateProjectile>
	</ThingDef>

	<ThingDef Class="CombatExtended.AmmoDef" ParentName="Ammo57x480mmRBase">
		<defName>Ammo_57x480mmR_HE</defName>
		<label>57x480mmR cartridge (HE)</label>
		<graphicData>
			<texPath>Things/Ammo/Cannon/Tank/HE</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>
		<statBases>
			<Mass>6.29</Mass>
			<MarketValue>25.63</MarketValue>
		</statBases>
		<ammoClass>GrenadeHE</ammoClass>
		<detonateProjectile>Bullet_57x480mmR_HE</detonateProjectile>
	</ThingDef>

	<!-- ================== Projectiles ================== -->

	<ThingDef Name="Base57x480mmRBullet" ParentName="BaseExplosiveBullet" Abstract="true">
		<graphicData>
			<texPath>Things/Projectile/Bullet_Big</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<flyOverhead>false</flyOverhead>
			<dropsCasings>true</dropsCasings>
			<casingMoteDefname>Fleck_BigShell</casingMoteDefname>
			<casingFilthDefname>Filth_CannonAmmoCasings</casingFilthDefname>
		</projectile>
	</ThingDef>

	<ThingDef ParentName="Base57x480mmRBullet">
		<defName>Bullet_57x480mmR_AP</defName>
		<label>57x480mmR bullet (APHE)</label>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<speed>181</speed>
			<damageDef>Bullet</damageDef>
			<damageAmountBase>196</damageAmountBase>
			<armorPenetrationSharp>142</armorPenetrationSharp>
			<armorPenetrationBlunt>21000</armorPenetrationBlunt>
			<secondaryDamage>
				<li>
					<def>Bomb_Secondary</def>
					<amount>80</amount>
				</li>
			</secondaryDamage>
		</projectile>
	</ThingDef>

	<ThingDef ParentName="Base57x480mmRBullet">
		<defName>Bullet_57x480mmR_HE</defName>
		<label>57x480mmR bullet (HE)</label>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<speed>140</speed>
			<damageDef>Bomb</damageDef>
			<damageAmountBase>72</damageAmountBase>
			<explosionRadius>2</explosionRadius>
			<soundExplode>MortarBomb_Explode</soundExplode>
			<applyDamageToExplosionCellsNeighbors>true</applyDamageToExplosionCellsNeighbors>
		</projectile>
		<comps>
			<li Class="CombatExtended.CompProperties_Fragments">
				<fragments>
					<Fragment_Large>5</Fragment_Large>
					<Fragment_Small>8</Fragment_Small>
				</fragments>
			</li>
		</comps>
	</ThingDef>

	<!-- ==================== Recipes ========================== -->

	<RecipeDef ParentName="AmmoRecipeBase">
		<defName>MakeAmmo_57x480mmR_AP</defName>
		<label>make 57x480mmR (APHE) shells x10</label>
		<description>Craft 10 57x480mmR (APHE) shells.</description>
		<jobString>Making 57x480mmR (APHE) shells.</jobString>
		<workAmount>8500</workAmount>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Steel</li>
					</thingDefs>
				</filter>
				<count>90</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Powder</li>
					</thingDefs>
				</filter>
				<count>18</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>Steel</li>
				<li>Powder</li>
			</thingDefs>
		</fixedIngredientFilter>
		<products>
			<Ammo_57x480mmR_AP>10</Ammo_57x480mmR_AP>
		</products>
		<skillRequirements>
			<Crafting>4</Crafting>
		</skillRequirements>
	    <researchPrerequisite>RT_WW2MediumArmor</researchPrerequisite>
  </RecipeDef>

	<RecipeDef ParentName="AmmoRecipeBase">
		<defName>MakeAmmo_57x480mmR_HE</defName>
		<label>make 57x480mmR (HE) shells x10</label>
		<description>Craft 10 57x480mmR (HE) shells.</description>
		<jobString>Making 57x480mmR (HE) shells.</jobString>
		<workAmount>9000</workAmount>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Steel</li>
					</thingDefs>
				</filter>
				<count>80</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Powder</li>
					</thingDefs>
				</filter>
				<count>16</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>FSX</li>
					</thingDefs>
				</filter>
				<count>12</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>ComponentIndustrial</li>
					</thingDefs>
				</filter>
				<count>1</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>Steel</li>
				<li>Powder</li>
				<li>FSX</li>
				<li>ComponentIndustrial</li>
			</thingDefs>
		</fixedIngredientFilter>
		<products>
			<Ammo_57x480mmR_HE>10</Ammo_57x480mmR_HE>
		</products>
		<skillRequirements>
			<Crafting>4</Crafting>
		</skillRequirements>
	    <researchPrerequisite>RT_WW2MediumArmor</researchPrerequisite>
  </RecipeDef>

</Defs>