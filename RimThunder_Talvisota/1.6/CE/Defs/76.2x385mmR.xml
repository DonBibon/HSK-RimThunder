	<ThingDef Class="CombatExtended.AmmoDef" Name="762x385mmRCannonShellBase" ParentName="HeavyAmmoBase" Abstract="True">
		<description>Light cannon shell used in 76.2mm tank and field guns.</description>
		<thingCategories>
			<li>Ammo762x385mmRCannonShells</li>
		</thingCategories>
		<stackLimit>25</stackLimit>
		<tradeTags>
			<li>CE_AutoEnableTrade</li>
			<li>CE_AutoEnableCrafting_TableMachining</li>
		</tradeTags>
		<statBases>
