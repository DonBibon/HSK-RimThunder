  </CombatExtended.AmmoSetDef>
  <!-- ==================== Ammo ========================== -->
  <ThingDef Class="CombatExtended.AmmoDef" Name="152mmNGBase" ParentName="HeavyAmmoBase" Abstract="True">
    <thingCategories>
      <li>Ammo152mmNG</li>
    </thingCategories>
    <stackLimit>25</stackLimit>
    <tradeTags>
      <li>CE_AutoEnableTrade</li>
      <li>CE_AutoEnableCrafting_TableHeavyAmmunition</li>
    </tradeTags>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <Mass>65</Mass>
      <Bulk>48</Bulk>
    </statBases>
    <cookOffFlashScale>30</cookOffFlashScale>
    <cookOffSound>MortarBomb_Explode</cookOffSound>
    <isMortarAmmo>true</isMortarAmmo>
  </ThingDef>
  <ThingDef Class="CombatExtended.AmmoDef" ParentName="152mmNGBase">
    <defName>Ammo_152mmNG_HE</defName>
    <label>152mm cannon shell (HE)</label>
    <graphicData>
      <texPath>Things/Ammo/152mm_HE</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>75</MarketValue>
      <Mass>75</Mass>
    </statBases>
    <ammoClass>GrenadeHE</ammoClass>
    <detonateProjectile>Bullet_152mmNG_HE</detonateProjectile>
  </ThingDef>
  <ThingDef Class="CombatExtended.AmmoDef" ParentName="152mmNGBase">
    <defName>Ammo_152mmNG_Sabot</defName>
