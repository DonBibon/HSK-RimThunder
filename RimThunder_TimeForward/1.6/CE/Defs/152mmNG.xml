  <!-- ================== Projectiles ================== -->
  <ThingDef Name="Base152mmNG" ParentName="BaseExplosiveBullet" Abstract="true">
    <graphicData>
      <shaderType>TransparentPostLight</shaderType>
    </graphicData>
    <projectile Class="CombatExtended.ProjectilePropertiesCE">
      <speed>170</speed>
      <soundExplode>MortarBomb_Explode</soundExplode>
      <flyOverhead>false</flyOverhead>
      <dropsCasings>true</dropsCasings>
      <casingMoteDefname>Fleck_BigShell</casingMoteDefname>
      <casingFilthDefname>Filth_CannonAmmoCasings</casingFilthDefname>
    </projectile>
  </ThingDef>
  <ThingDef ParentName="Base152mmNG">
    <defName>Bullet_152mmNG_HE</defName>
    <label>152mm cannon shell (HE)</label>
    <thingClass>CombatExtended.ProjectileCE_Explosive</thingClass>
    <graphicData>
      <texPath>Things/Projectile/Ammo_152_HE</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile Class="CombatExtended.ProjectilePropertiesCE">
      <damageDef>Bomb</damageDef>
      <damageAmountBase>520</damageAmountBase>
      <explosionRadius>5.5</explosionRadius>
      <soundExplode>MortarBomb_Explode</soundExplode>
      <applyDamageToExplosionCellsNeighbors>true</applyDamageToExplosionCellsNeighbors>
      <speed>184</speed>
    </projectile>
    <comps>
      <li Class="CombatExtended.CompProperties_Fragments">
        <fragments>
          <Fragment_Large>48</Fragment_Large>
          <Fragment_Small>80</Fragment_Small>
        </fragments>
      </li>
    </comps>
  </ThingDef>
  <ThingDef ParentName="Base152mmNG">
    <defName>Bullet_152mmNG_EMP</defName>
    <label>152mm cannon shell (EMP)</label>
    <thingClass>CombatExtended.ProjectileCE_Explosive</thingClass>
    <graphicData>
      <texPath>Things/Projectile/Ammo_152_EMP</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile Class="CombatExtended.ProjectilePropertiesCE">
      <damageDef>EMP</damageDef>
      <damageAmountBase>420</damageAmountBase>
      <armorPenetrationSharp>0</armorPenetrationSharp>
      <armorPenetrationBlunt>0</armorPenetrationBlunt>
      <explosionRadius>9.5</explosionRadius>
      <speed>184</speed>
    </projectile>
  </ThingDef>
  <ThingDef ParentName="Base152mmNG">
    <defName>Bullet_152mmNG_Sabot</defName>
    <label>152mm cannon shell (APFSDS)</label>
    <graphicData>
      <texPath>Things/Projectile/Ammo_3BM69</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile Class="CombatExtended.ProjectilePropertiesCE">
      <speed>330</speed>
      <damageDef>Bullet</damageDef>
      <damageAmountBase>500</damageAmountBase>
      <soundExplode>MortarBomb_Explode</soundExplode>
      <armorPenetrationSharp>760</armorPenetrationSharp>
      <armorPenetrationBlunt>240000</armorPenetrationBlunt>
      <secondaryDamage>
        <li>
          <def>Bomb_Secondary</def>
          <amount>150</amount>
        </li>
      </secondaryDamage>
    </projectile>
    <comps>
      <li Class="CombatExtended.CompProperties_Fragments">
        <fragXZAngleRange>-5~5</fragXZAngleRange>
        <fragAngleRange>0~2</fragAngleRange>
        <fragments>
          <Fragment_APFSDS>15</Fragment_APFSDS>
        </fragments>
      </li>
    </comps>
  </ThingDef>
