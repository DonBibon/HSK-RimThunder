  </ThingCategoryDef>
  <!-- ==================== AmmoSet ========================== -->
  <CombatExtended.AmmoSetDef>
    <defName>AmmoSet_152mmNG</defName>
    <label>152mmTC cannon shells</label>
    <ammoTypes>
      <Ammo_152mmNG_HE>Bullet_152mmNG_HE</Ammo_152mmNG_HE>
      <!--3OF82-->
      <Ammo_152mmNG_EMP>Bullet_152mmNG_EMP</Ammo_152mmNG_EMP>
      <Ammo_152mmNG_Sabot>Bullet_152mmNG_Sabot</Ammo_152mmNG_Sabot>
