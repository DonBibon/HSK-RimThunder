      <MarketValue>60</MarketValue>
      <Mass>35</Mass>
    </statBases>
    <ammoClass>Sabot</ammoClass>
    <detonateProjectile>Bullet_152mmNG_Sabot</detonateProjectile>
  </ThingDef>
  <ThingDef Class="CombatExtended.AmmoDef" ParentName="152mmNGBase">
    <defName>Ammo_152mmNG_EMP</defName>
