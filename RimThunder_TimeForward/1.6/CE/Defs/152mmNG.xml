  <RecipeDef ParentName="AmmoRecipeBase">
    <defName>MakeAmmo_152mmNG_HE</defName>
    <label>make 152mm HE cannon shells x5</label>
    <description>Craft 5 152mm HE cannon shells.</description>
    <jobString>Making 5 152mm HE cannon shells.</jobString>
    <workAmount>16000</workAmount>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </filter>
        <count>250</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>FSX</li>
          </thingDefs>
        </filter>
        <count>40</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Powder</li>
          </thingDefs>
        </filter>
        <count>60</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>ComponentIndustrial</li>
          </thingDefs>
        </filter>
        <count>5</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Steel</li>
        <li>FSX</li>
        <li>Powder</li>
        <li>ComponentIndustrial</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <Ammo_152mmNG_HE>5</Ammo_152mmNG_HE>
    </products>
    <skillRequirements>
      <Crafting>4</Crafting>
    </skillRequirements>
    <researchPrerequisite>RT_NextGenArmata</researchPrerequisite>
  </RecipeDef>
