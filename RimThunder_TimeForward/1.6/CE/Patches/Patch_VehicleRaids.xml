<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>blakil.vehiclesceoverhaul</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationAdd">
					<xpath>Defs/VehiclesCEOverhaul.VehicleRaidTuningDef[defName="VCEO_VehicleRaidTuning"]/adaptedVehicles</xpath>
					<value>
						<li>RT_T14_MainBattleTank</li>
						<li>RT_T15_Vehicle</li>
					</value>
				</li>
				<li Class="PatchOperationAddModExtension">
					<xpath>Defs/Vehicles.VehicleDef[defName="RT_T14_MainBattleTank"]</xpath>
					<value>
						<li Class="VehiclesCEOverhaul.VehicleRaidExtension">
							<mode>Factions</mode>
							<factions>
								<li>Empire</li>
								<li>NovaAlliance</li>
								<li>Orion</li>
								<li>Syndicate</li>
								<li>Brotherhood</li>
							</factions>
							<costFactor>1.0</costFactor>
						</li>
						<li Class="VehiclesCEOverhaul.VehicleRaidRoleExtension">
							<role>Breacher</role>
						</li>
					</value>
				</li>
				<li Class="PatchOperationAddModExtension">
					<xpath>Defs/Vehicles.VehicleDef[defName="RT_T15_Vehicle"]</xpath>
					<value>
						<li Class="VehiclesCEOverhaul.VehicleRaidExtension">
							<mode>Factions</mode>
							<factions>
								<li>Empire</li>
								<li>NovaAlliance</li>
								<li>Orion</li>
								<li>Syndicate</li>
								<li>Brotherhood</li>
							</factions>
							<costFactor>1.0</costFactor>
						</li>
						<li Class="VehiclesCEOverhaul.VehicleRaidRoleExtension">
							<role>Breacher</role>
						</li>
					</value>
				</li>
			</operations>
		</match>
	</Operation>
</Patch>
