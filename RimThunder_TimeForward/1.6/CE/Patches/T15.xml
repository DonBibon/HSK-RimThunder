<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- Turret -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="T15_EpochAlmaty_Turret"]/projectile</xpath>
		<value>
			<projectile>Bullet_30x173mm_FMJ</projectile>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="T15_EpochAlmaty_Turret"]/chargePerAmmoCount</xpath>
		<value>
			<chargePerAmmoCount>1</chargePerAmmoCount>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="T15_EpochAlmaty_Turret"]/genericAmmo</xpath>
		<value>
			<genericAmmo>false</genericAmmo>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="T15_EpochAlmaty_Turret"]/maxRange</xpath>
		<value>
			<maxRange>72</maxRange>
		</value>
	</Operation>

	<Operation Class="PatchOperationAddModExtension">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="T15_EpochAlmaty_Turret"]</xpath>
		<value>
			<li Class="Vehicles.CETurretDataDefModExtension">
				<ammoSet>AmmoSet_30x173mm</ammoSet>
				<shotHeight>1.9</shotHeight>
				<sway>0.82</sway>
				<spread>0.01</spread>
			</li>
		</value>
	</Operation>
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="T15_EpochAlmaty_Turret"]/ammunition</xpath>
		<match Class="PatchOperationReplace">
			<xpath>Defs/Vehicles.VehicleTurretDef[defName="T15_EpochAlmaty_Turret"]/ammunition</xpath>
			<value>
				<ammunition Inherit="False">
					<thingDefs>
						<li>Ammo_30x173mm_FMJ</li>
						<li>Ammo_30x173mm_HE</li>
						<li>Ammo_30x173mm_Incendiary</li>
					</thingDefs>
				</ammunition>
			</value>
		</match>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/Vehicles.VehicleTurretDef[defName="T15_EpochAlmaty_Turret"]</xpath>
			<value>
				<ammunition Inherit="False">
					<thingDefs>
						<li>Ammo_30x173mm_FMJ</li>
						<li>Ammo_30x173mm_HE</li>
						<li>Ammo_30x173mm_Incendiary</li>
					</thingDefs>
				</ammunition>
			</value>
		</nomatch>
	</Operation>

